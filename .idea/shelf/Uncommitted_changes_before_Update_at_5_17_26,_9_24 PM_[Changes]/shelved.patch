+    // --- USE CASE 3: EMERGENCY OVERLAY ---
+    let incidentCircle = null;
+    let incidentEpicenter = null;
+    let residentLayerGroup = L.layerGroup().addTo(map);
+
+    function loadEmergencyOverlay(lat, lng, radiusMeters) {
+        // Epicenter marker
+        const incIcon = L.divIcon({
+            className: '',
+            html: '<div style="width:20px;height:20px;background:#ff4757;border:3px solid white;border-radius:50%;box-shadow:0 0 12px #ff4757;"></div>',
+            iconAnchor: [10, 10]
+        });
+        if (incidentEpicenter) incidentEpicenter.remove();
+        incidentEpicenter = L.marker([lat, lng], { icon: incIcon })
+            .addTo(map)
+            .bindPopup('<b>⚠ INCIDENT EPICENTER</b><br>Lat: ' + lat + '<br>Lng: ' + lng);
+
+        // Radius circle
+        if (incidentCircle) incidentCircle.remove();
+        incidentCircle = L.circle([lat, lng], {
+            radius: radiusMeters,
+            color: '#ff4757', fillColor: '#ff4757', fillOpacity: 0.08,
+            dashArray: '8 4', weight: 2
+        }).addTo(map);
+
+        // Fit map to circle
+        map.fitBounds(incidentCircle.getBounds().pad(0.2));
+    }
+
+    function addResidentMarker(lat, lng, name, address, isVulnerable, isInZone, distMeters, vulnTypes) {
+        const color    = isVulnerable && isInZone ? '#ff4757' : isInZone ? '#60a5fa' : '#374151';
+        const size     = isVulnerable && isInZone ? 14 : 10;
+        const glow     = isVulnerable && isInZone ? '#ff4757' : isInZone ? '#3b82f6' : 'transparent';
+        const badge    = isVulnerable ? 'P1: Vulnerable' : isInZone ? 'P2: General' : 'Outside Zone';
+        const bgColor  = isVulnerable ? '#7f1d1d' : isInZone ? '#1e3a5f' : '#374151';
+        const txtColor = isVulnerable ? '#fca5a5' : isInZone ? '#60a5fa' : '#9ca3af';
+        const icon = L.divIcon({
+            className: '',
+            html: `<div style="width:${size}px;height:${size}px;background:${color};border:2px solid white;border-radius:50%;box-shadow:0 0 6px ${glow};"></div>`,
+            iconAnchor: [size / 2, size / 2]
+        });
+        const popup = `
+        <div style="font-family:monospace;font-size:12px;min-width:180px;">
+            <div style="font-weight:bold;font-size:13px;color:#000000;margin-bottom:4px;">${name}</div>
+            <div style="color:#000000;font-size:11px;margin-bottom:4px;">${address}</div>
+            <span style="display:inline-block;border-radius:8px;padding:2px 8px;font-size:10px;font-weight:bold;background:${bgColor};color:${txtColor};">${badge}</span>
+            ${vulnTypes ? `<div style="color:#000000;font-size:11px;margin-top:3px;">${vulnTypes}</div>` : ''}
+            <div style="color:#000000;font-size:10px;margin-top:3px;"> ${distMeters} m from incident</div>
+        </div>`;
+        residentLayerGroup.addLayer(L.marker([lat, lng], { icon }).bindPopup(popup));
+    }
+
+    function clearResidentMarkers() {
+        residentLayerGroup.clearLayers();
+    }
+
+
 </script>
