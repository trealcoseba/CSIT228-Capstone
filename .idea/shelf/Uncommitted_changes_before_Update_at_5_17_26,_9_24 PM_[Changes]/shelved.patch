<+><?xml version=\"1.0\" encoding=\"UTF-8\"?>\n\n<?import javafx.scene.chart.*?>\n<?import javafx.scene.control.*?>\n<?import javafx.scene.control.cell.*?>\n<?import javafx.scene.layout.*?>\n<?import javafx.scene.web.*?>\n\n<BorderPane prefHeight=\"900\" prefWidth=\"1440\" style=\"-fx-background-color: #0d1117;\" styleClass=\"root-pane\" stylesheets=\"@../../../../css/application.css\" xmlns=\"http://javafx.com/javafx/17.0.12\" xmlns:fx=\"http://javafx.com/fxml/1\" fx:controller=\"com.example.csit228capstone.controller.emergency.EmergencyController\">\n\n    <!-- ============================================================ -->\n    <!-- TOP: INCIDENT OVERVIEW PANEL                                  -->\n    <!-- ============================================================ -->\n    <top>\n        <VBox style=\"-fx-background-color: #161b22; -fx-border-color: #ff4757; -fx-border-width: 0 0 2 0;\">\n\n            <!-- Command Bar — styled like top-bar from dashboard -->\n            <HBox alignment=\"CENTER_LEFT\" spacing=\"12\" style=\"-fx-padding: 9 16 9 16; -fx-background-color: #ff4757;\">\n                <Label style=\"-fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold;\" styleClass=\"brand-title\" text=\"⚠  LIGTAS-BRGY — EMERGENCY OPERATIONS CENTER\" />\n                <Region HBox.hgrow=\"ALWAYS\" />\n                <Label fx:id=\"lblSystemTime\" style=\"-fx-text-fill: white; -fx-font-size: 12px; -fx-font-family: 'Courier New';\" text=\"--:--:--\" />\n                <Label style=\"-fx-text-fill: #00ff88; -fx-font-size: 10px;\" text=\"●\" />\n                <Label style=\"-fx-text-fill: #00ff88; -fx-font-size: 11px; -fx-font-weight: bold;\" styleClass=\"active-incidents-badge\" text=\"LIVE\" />\n            </HBox>\n\n            <!-- KPI / Incident Detail Cards Row — mirrors kpiRow from dashboard -->\n            <HBox fx:id=\"incidentKpiRow\" alignment=\"CENTER_LEFT\" spacing=\"12\" style=\"-fx-padding: 12 16 12 16;\">\n\n                <!-- Emergency Type -->\n                <VBox style=\"-fx-background-color: #1f2937; -fx-min-width: 155; -fx-padding: 10 16 10 16; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: rgba(192,57,43,0.35); -fx-border-width: 1;\" styleClass=\"kpi-card, kpi-danger\">\n                    <Label style=\"-fx-text-fill: #6b7280; -fx-font-size: 9px; -fx-font-weight: bold;\" styleClass=\"kpi-label\" text=\"EMERGENCY TYPE\" />\n                    <Label fx:id=\"lblEmergencyType\" style=\"-fx-text-fill: #ff4757; -fx-font-size: 15px; -fx-font-weight: bold;\" styleClass=\"kpi-value\" text=\"—\" />\n                    <Label style=\"-fx-text-fill: #4b5563; -fx-font-size: 9px;\" styleClass=\"kpi-sub\" text=\"Active incident\" />\n                </VBox>\n\n                <!-- Severity Badge -->\n                <VBox style=\"-fx-background-color: #1f2937; -fx-min-width: 125; -fx-padding: 10 16 10 16; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #21262d; -fx-border-width: 1;\" styleClass=\"kpi-card\">\n                    <Label style=\"-fx-text-fill: #6b7280; -fx-font-size: 9px; -fx-font-weight: bold;\" styleClass=\"kpi-label\" text=\"SEVERITY\" />\n                    <HBox alignment=\"CENTER_LEFT\" spacing=\"6\">\n                        <Label fx:id=\"lblSeverityDot\" style=\"-fx-text-fill: #ff4757; -fx-font-size: 12px;\" text=\"●\" />\n                        <Label fx:id=\"lblSeverity\" style=\"-fx-text-fill: #f9fafb; -fx-font-size: 15px; -fx-font-weight: bold;\" styleClass=\"kpi-value\" text=\"—\" />\n                    </HBox>\n                    <Label style=\"-fx-text-fill: #4b5563; -fx-font-size: 9px;\" styleClass=\"kpi-sub\" text=\"Threat level\" />\n                </VBox>\n\n                <!-- Timestamp -->\n                <VBox style=\"-fx-background-color: #1f2937; -fx-min-width: 180; -fx-padding: 10 16 10 16; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #21262d; -fx-border-width: 1;\" styleClass=\"kpi-card\">\n                    <Label style=\"-fx-text-fill: #6b7280; -fx-font-size: 9px; -fx-font-weight: bold;\" styleClass=\"kpi-label\" text=\"TIMESTAMP\" />\n                    <Label fx:id=\"lblTimestamp\" style=\"-fx-text-fill: #f9fafb; -fx-font-size: 13px; -fx-font-family: 'Courier New';\" text=\"—\" />\n                    <Label style=\"-fx-text-fill: #4b5563; -fx-font-size: 9px;\" styleClass=\"kpi-sub\" text=\"Incident reported\" />\n                </VBox>\n\n                <!-- Status Indicator -->\n                <VBox style=\"-fx-background-color: #1f2937; -fx-min-width: 125; -fx-padding: 10 16 10 16; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #21262d; -fx-border-width: 1;\" styleClass=\"kpi-card\">\n                    <Label style=\"-fx-text-fill: #6b7280; -fx-font-size: 9px; -fx-font-weight: bold;\" styleClass=\"kpi-label\" text=\"STATUS\" />\n                    <Label fx:id=\"lblStatus\" style=\"-fx-text-fill: #fbbf24; -fx-font-size: 13px; -fx-font-weight: bold;\" text=\"—\" />\n                    <Label style=\"-fx-text-fill: #4b5563; -fx-font-size: 9px;\" styleClass=\"kpi-sub\" text=\"Response state\" />\n                </VBox>\n\n                <!-- Incident Coordinates -->\n                <VBox minWidth=\"188.0\" prefHeight=\"63.0\" prefWidth=\"188.0\" style=\"-fx-background-color: #1f2937; -fx-min-width: 200; -fx-padding: 10 16 10 16; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: rgba(52,152,219,0.25); -fx-border-width: 1;\" styleClass=\"kpi-card, kpi-info\">\n                    <Label style=\"-fx-text-fill: #6b7280; -fx-font-size: 9px; -fx-font-weight: bold;\" styleClass=\"kpi-label\" text=\"INCIDENT COORDINATES\" />\n                    <Label fx:id=\"lblCoordinates\" style=\"-fx-text-fill: #60a5fa; -fx-font-size: 13px; -fx-font-family: 'Courier New';\" text=\"—\" />\n                    <Label style=\"-fx-text-fill: #4b5563; -fx-font-size: 9px;\" styleClass=\"kpi-sub\" text=\"GPS location\" />\n                </VBox>\n\n                <!-- Affected Radius -->\n                <VBox style=\"-fx-background-color: #1f2937; -fx-min-width: 125; -fx-padding: 10 16 10 16; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #21262d; -fx-border-width: 1;\" styleClass=\"kpi-card\">\n                    <Label style=\"-fx-text-fill: #6b7280; -fx-font-size: 9px; -fx-font-weight: bold;\" styleClass=\"kpi-label\" text=\"AFFECTED RADIUS\" />\n                    <Label fx:id=\"lblAffectedRadius\" style=\"-fx-text-fill: #f9fafb; -fx-font-size: 15px; -fx-font-weight: bold;\" styleClass=\"kpi-value\" text=\"—\" />\n                    <Label style=\"-fx-text-fill: #4b5563; -fx-font-size: 9px;\" styleClass=\"kpi-sub\" text=\"Impact zone\" />\n                </VBox>\n\n                <Region prefHeight=\"63.0\" prefWidth=\"0.0\" HBox.hgrow=\"ALWAYS\" />\n\n                <!-- Action Buttons — styled like quick-action-btn -->\n                <HBox alignment=\"CENTER_RIGHT\" spacing=\"8\">\n                    <Button fx:id=\"btnActivateDispatch\" onAction=\"#assignDispatch\" prefHeight=\"46.0\" prefWidth=\"119.0\" style=\"-fx-font-size: 12px; -fx-padding: 8 14 8 14;\" styleClass=\"quick-action-btn, qa-danger\" text=\"Activate &#10;Dispatch\" />\n                    <Button fx:id=\"btnNotifyResidents\" onAction=\"#notifyResidents\" prefHeight=\"48.0\" prefWidth=\"85.0\" style=\"-fx-font-size: 12px; -fx-padding: 8 14 8 14;\" styleClass=\"quick-action-btn, qa-warning\" text=\"Notify&#10; Residents\" textAlignment=\"CENTER\" />\n                    <Button fx:id=\"btnRefreshData\" onAction=\"#refreshDashboard\" style=\"-fx-font-size: 12px; -fx-padding: 8 14 8 14; -fx-text-fill: #9ca3af; -fx-border-color: #374151;\" styleClass=\"btn-outline\" text=\"Refresh\" />\n                    <Button fx:id=\"btnEndEmergency\" onAction=\"#endEmergency\" style=\"-fx-background-color: #111827; -fx-text-fill: #ef4444; -fx-font-weight: bold; -fx-font-size: 12px; -fx-background-radius: 8; -fx-padding: 8 14 8 14; -fx-cursor: hand; -fx-border-color: #ef4444; -fx-border-radius: 8;\" text=\"End Emergency\" />\n                </HBox>\n\n            </HBox>\n        </VBox>\n    </top>\n\n    <!-- ============================================================ -->\n    <!-- LEFT: RESIDENTS PRIORITY PANEL                                -->\n    <!-- ============================================================ -->\n    <left>\n        <VBox prefWidth=\"315\" spacing=\"0\" style=\"-fx-background-color: #161b22; -fx-border-color: #21262d; -fx-border-width: 0 1 0 0;\">\n\n            <!-- Priority Residents Header — panel-card style header -->\n            <HBox alignment=\"CENTER_LEFT\" spacing=\"8\" style=\"-fx-padding: 10 14 10 14; -fx-background-color: #1f2937; -fx-border-color: #21262d; -fx-border-width: 0 0 1 0;\">\n                <Label style=\"-fx-text-fill: #f9fafb; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 0;\" styleClass=\"panel-title\" text=\"PRIORITY RESIDENTS\" />\n                <Region HBox.hgrow=\"ALWAYS\" />\n                <Label fx:id=\"lblResidentCount\" style=\"-fx-text-fill: #60a5fa; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-color: #1e3a5f; -fx-background-radius: 10; -fx-padding: 2 8 2 8;\" text=\"0\" />\n            </HBox>\n\n            <!-- Priority Legend — clean pill-style like status badges -->\n            <HBox spacing=\"10\" style=\"-fx-padding: 6 14 2 14; -fx-background-color: #161b22;\">\n                <HBox alignment=\"CENTER_LEFT\" spacing=\"4\" style=\"-fx-background-color: rgba(192,57,43,0.12); -fx-background-radius: 10; -fx-padding: 3 8 3 8;\">\n                    <Label style=\"-fx-text-fill: #ff4757; -fx-font-size: 8px;\" text=\"●\" />\n                    <Label style=\"-fx-text-fill: #ff4757; -fx-font-size: 9px; -fx-font-weight: bold;\" text=\"P1: Vulnerable\" />\n                </HBox>\n                <HBox alignment=\"CENTER_LEFT\" spacing=\"4\" style=\"-fx-background-color: rgba(52,152,219,0.12); -fx-background-radius: 10; -fx-padding: 3 8 3 8;\">\n                    <Label style=\"-fx-text-fill: #60a5fa; -fx-font-size: 8px;\" text=\"●\" />\n                    <Label style=\"-fx-text-fill: #60a5fa; -fx-font-size: 9px; -fx-font-weight: bold;\" text=\"P2: General\" />\n                </HBox>\n            </HBox>\n            <VBox style=\"-fx-padding: 0 0 4 0;\" />\n\n            <!-- Priority Residents Table — incident-table style -->\n            <TableView fx:id=\"tblPriorityResidents\" style=\"-fx-background-color: #161b22; -fx-border-color: transparent; -fx-table-cell-border-color: #21262d; -fx-font-size: 11px;\" styleClass=\"incident-table\" VBox.vgrow=\"ALWAYS\">\n                <columns>\n                    <TableColumn fx:id=\"colResidentName\" prefWidth=\"105\" text=\"Name\">\n                        <cellValueFactory><PropertyValueFactory property=\"residentName\" /></cellValueFactory>\n                    </TableColumn>\n                    <TableColumn fx:id=\"colVulnerability\" prefWidth=\"80\" text=\"Type\">\n                        <cellValueFactory><PropertyValueFactory property=\"vulnerabilityType\" /></cellValueFactory>\n                    </TableColumn>\n                    <TableColumn fx:id=\"colDistance\" prefWidth=\"65\" text=\"Dist (m)\">\n                        <cellValueFactory><PropertyValueFactory property=\"distanceFromIncident\" /></cellValueFactory>\n                    </TableColumn>\n                    <TableColumn fx:id=\"colRescueStatus\" prefWidth=\"65\" text=\"Status\">\n                        <cellValueFactory><PropertyValueFactory property=\"rescueStatus\" /></cellValueFactory>\n                    </TableColumn>\n                </columns>\n                <placeholder>\n                    <Label style=\"-fx-text-fill: #4b5563; -fx-font-size: 11px;\" text=\"No affected residents loaded.\" />\n                </placeholder>\n            </TableView>\n\n            <!-- Missing Residents Header — danger-tinted panel header -->\n            <HBox alignment=\"CENTER_LEFT\" spacing=\"8\" style=\"-fx-padding: 9 14 9 14; -fx-background-color: #2d1b1b; -fx-border-color: #7f1d1d; -fx-border-width: 1 0 1 0;\">\n                <Label style=\"-fx-text-fill: #fca5a5; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 0;\" styleClass=\"panel-title\" text=\"MISSING RESIDENTS\" />\n                <Region HBox.hgrow=\"ALWAYS\" />\n                <Label fx:id=\"lblMissingCount\" style=\"-fx-text-fill: #fca5a5; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-color: #7f1d1d; -fx-background-radius: 10; -fx-padding: 2 8 2 8;\" text=\"0\" />\n            </HBox>\n\n            <!-- Missing Residents Table -->\n            <TableView fx:id=\"tblMissingResidents\" prefHeight=\"185\" style=\"-fx-background-color: #1a0e0e; -fx-border-color: transparent; -fx-table-cell-border-color: #2d1b1b; -fx-font-size: 11px;\" styleClass=\"incident-table\">\n                <columns>\n                    <TableColumn fx:id=\"colMissingName\" prefWidth=\"100\" text=\"Name\">\n                        <cellValueFactory><PropertyValueFactory property=\"residentName\" /></cellValueFactory>\n                    </TableColumn>\n                    <TableColumn fx:id=\"colMissingContact\" prefWidth=\"100\" text=\"Contact\">\n                        <cellValueFactory><PropertyValueFactory property=\"contactNumber\" /></cellValueFactory>\n                    </TableColumn>\n                    <TableColumn fx:id=\"colLastKnownLocation\" prefWidth=\"115\" text=\"Last Location\">\n                        <cellValueFactory><PropertyValueFactory property=\"lastKnownLocation\" /></cellValueFactory>\n                    </TableColumn>\n                </columns>\n                <placeholder>\n                    <Label style=\"-fx-text-fill: #4b5563; -fx-font-size: 11px;\" text=\"No missing residents reported.\" />\n                </placeholder>\n            </TableView>\n\n        </VBox>\n    </left>\n\n    <!-- ============================================================ -->\n    <!-- CENTER: LIVE MAP PANEL                                        -->\n    <!-- ============================================================ -->\n    <center>\n        <StackPane style=\"-fx-background-color: #0d1117;\">\n\n            <!-- Map WebView fills entire center -->\n            <AnchorPane style=\"-fx-background-color: #0d1117;\">\n                <WebView fx:id=\"mapWebView\" AnchorPane.bottomAnchor=\"0\" AnchorPane.leftAnchor=\"0\" AnchorPane.rightAnchor=\"0\" AnchorPane.topAnchor=\"0\" />\n            </AnchorPane>\n\n            <!-- Floating Map Header Overlay — top-bar style -->\n            <VBox alignment=\"TOP_LEFT\" pickOnBounds=\"false\">\n                <HBox alignment=\"CENTER_LEFT\" spacing=\"8\" style=\"-fx-padding: 8 12 8 12; -fx-background-color: rgba(22,27,34,0.92); -fx-border-color: #21262d; -fx-border-width: 0 0 1 0;\">\n                    <Label style=\"-fx-text-fill: #f9fafb; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 0;\" styleClass=\"panel-title\" text=\"LIVE INCIDENT MAP\" />\n                    <Label style=\"-fx-text-fill: #00ff88; -fx-font-size: 9px;\" text=\"●\" />\n                    <Label style=\"-fx-text-fill: #00ff88; -fx-font-size: 10px; -fx-font-weight: bold;                                   -fx-background-color: rgba(0,255,136,0.12); -fx-background-radius: 10; -fx-padding: 2 8 2 8;\" text=\"REAL-TIME\" />\n                    <Region HBox.hgrow=\"ALWAYS\" />\n                    <Label fx:id=\"lblMapCoords\" style=\"-fx-text-fill: #6b7280; -fx-font-size: 10px; -fx-font-family: 'Courier New';\" text=\"Lat: — | Lng: —\" />\n                </HBox>\n            </VBox>\n\n        </StackPane>\n    </center>\n\n    <!-- ============================================================ -->\n    <!-- RIGHT: EVACUATION + RESCUE TEAMS + RESOURCES PANEL           -->\n    <!-- ============================================================ -->\n    <right>\n        <VBox prefWidth=\"325\" spacing=\"0\" style=\"-fx-background-color: #161b22; -fx-border-color: #21262d; -fx-border-width: 0 0 0 1;\">\n\n            <!-- SECTION 1: Evacuation Centers — panel-card header style -->\n            <VBox VBox.vgrow=\"ALWAYS\">\n                <HBox alignment=\"CENTER_LEFT\" spacing=\"8\" style=\"-fx-padding: 10 14 10 14; -fx-background-color: #1f2937; -fx-border-color: #21262d; -fx-border-width: 0 0 1 0;\">\n                    <Label style=\"-fx-text-fill: #f9fafb; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 0;\" styleClass=\"panel-title\" text=\"EVACUATION CENTERS\" />\n                    <Region HBox.hgrow=\"ALWAYS\" />\n                    <Label fx:id=\"lblEvacCenterCount\" style=\"-fx-text-fill: #34d399; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-color: #064e3b; -fx-background-radius: 10; -fx-padding: 2 8 2 8;\" text=\"0\" />\n                </HBox>\n\n                <TableView fx:id=\"tblEvacuationCenters\" style=\"-fx-background-color: #161b22; -fx-border-color: transparent; -fx-table-cell-border-color: #21262d; -fx-font-size: 10px;\" styleClass=\"incident-table\" VBox.vgrow=\"ALWAYS\">\n                    <columns>\n                        <TableColumn fx:id=\"colEvacName\" prefWidth=\"100\" text=\"Center\">\n                            <cellValueFactory><PropertyValueFactory property=\"centerName\" /></cellValueFactory>\n                        </TableColumn>\n                        <TableColumn fx:id=\"colEvacCapacity\" prefWidth=\"40\" text=\"Cap\">\n                            <cellValueFactory><PropertyValueFactory property=\"capacity\" /></cellValueFactory>\n                        </TableColumn>\n                        <TableColumn fx:id=\"colEvacOccupancy\" prefWidth=\"40\" text=\"Occ\">\n                            <cellValueFactory><PropertyValueFactory property=\"occupancy\" /></cellValueFactory>\n                        </TableColumn>\n                        <TableColumn fx:id=\"colEvacDistance\" prefWidth=\"52\" text=\"Dist\">\n                            <cellValueFactory><PropertyValueFactory property=\"distance\" /></cellValueFactory>\n                        </TableColumn>\n                        <TableColumn fx:id=\"colEvacStatus\" prefWidth=\"93\" text=\"Status\">\n                            <cellValueFactory><PropertyValueFactory property=\"status\" /></cellValueFactory>\n                        </TableColumn>\n                    </columns>\n                    <placeholder>\n                        <Label style=\"-fx-text-fill: #4b5563; -fx-font-size: 11px;\" text=\"No centers available.\" />\n                    </placeholder>\n                </TableView>\n            </VBox>\n\n            <!-- SECTION 2: Rescue Teams -->\n            <VBox VBox.vgrow=\"ALWAYS\">\n                <HBox alignment=\"CENTER_LEFT\" spacing=\"8\" style=\"-fx-padding: 10 14 10 14; -fx-background-color: #1f2937; -fx-border-color: #21262d; -fx-border-width: 1 0 1 0;\">\n                    <Label style=\"-fx-text-fill: #f9fafb; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 0;\" styleClass=\"panel-title\" text=\"RESCUE TEAMS\" />\n                    <Region HBox.hgrow=\"ALWAYS\" />\n                    <Label fx:id=\"lblTeamCount\" style=\"-fx-text-fill: #60a5fa; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-color: #1e3a5f; -fx-background-radius: 10; -fx-padding: 2 8 2 8;\" text=\"0\" />\n                </HBox>\n\n                <TableView fx:id=\"tblRescueTeams\" style=\"-fx-background-color: #161b22; -fx-border-color: transparent; -fx-table-cell-border-color: #21262d; -fx-font-size: 10px;\" styleClass=\"incident-table\" VBox.vgrow=\"ALWAYS\">\n                    <columns>\n                        <TableColumn fx:id=\"colTeamName\" prefWidth=\"95\" text=\"Team\">\n                            <cellValueFactory><PropertyValueFactory property=\"teamName\" /></cellValueFactory>\n                        </TableColumn>\n                        <TableColumn fx:id=\"colTeamAvailability\" prefWidth=\"72\" text=\"Status\">\n                            <cellValueFactory><PropertyValueFactory property=\"availability\" /></cellValueFactory>\n                        </TableColumn>\n                        <TableColumn fx:id=\"colTeamVehicle\" prefWidth=\"78\" text=\"Vehicle\">\n                            <cellValueFactory><PropertyValueFactory property=\"vehicle\" /></cellValueFactory>\n                        </TableColumn>\n                        <TableColumn fx:id=\"colTeamETA\" prefWidth=\"80\" text=\"ETA\">\n                            <cellValueFactory><PropertyValueFactory property=\"eta\" /></cellValueFactory>\n                        </TableColumn>\n                    </columns>\n                    <placeholder>\n                        <Label style=\"-fx-text-fill: #4b5563; -fx-font-size: 11px;\" text=\"No rescue teams available.\" />\n                    </placeholder>\n                </TableView>\n            </VBox>\n\n            <!-- SECTION 3: Resources — with progress bars like dashboard's Resource Status -->\n            <VBox VBox.vgrow=\"ALWAYS\">\n                <HBox alignment=\"CENTER_LEFT\" spacing=\"8\" style=\"-fx-padding: 10 14 10 14; -fx-background-color: #1f2937; -fx-border-color: #21262d; -fx-border-width: 1 0 0 0;\">\n                    <Label style=\"-fx-text-fill: #f9fafb; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 0;\" styleClass=\"panel-title\" text=\"RESOURCES\" />\n                    <Region HBox.hgrow=\"ALWAYS\" />\n                    <Label fx:id=\"lblResourceCount\" style=\"-fx-text-fill: #a78bfa; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-color: #2e1065; -fx-background-radius: 10; -fx-padding: 2 8 2 8;\" text=\"0\" />\n                </HBox>\n\n                <!-- Quick Resource Progress Summary — mirrors dashboard's Resource Status -->\n                <VBox spacing=\"6\" style=\"-fx-padding: 10 14 8 14; -fx-background-color: #161b22; -fx-border-color: #21262d; -fx-border-width: 0 0 1 0;\">\n                    <HBox alignment=\"CENTER_LEFT\">\n                        <Label style=\"-fx-text-fill: #9ca3af; -fx-font-size: 10px;\" styleClass=\"resource-label\" text=\"Relief Goods\" />\n                        <Region HBox.hgrow=\"ALWAYS\" />\n                        <Label fx:id=\"lblReliefPct\" style=\"-fx-text-fill: #6b7280; -fx-font-size: 10px;\" styleClass=\"resource-pct\" text=\"—\" />\n                    </HBox>\n                    <ProgressBar fx:id=\"pbRelief\" maxWidth=\"Infinity\" progress=\"0.0\" style=\"-fx-pref-height: 5; -fx-background-radius: 3;\" styleClass=\"progress-green\" />\n                    <HBox alignment=\"CENTER_LEFT\">\n                        <Label style=\"-fx-text-fill: #9ca3af; -fx-font-size: 10px;\" styleClass=\"resource-label\" text=\"Med Supplies\" />\n                        <Region HBox.hgrow=\"ALWAYS\" />\n                        <Label fx:id=\"lblMedPct\" style=\"-fx-text-fill: #6b7280; -fx-font-size: 10px;\" styleClass=\"resource-pct\" text=\"—\" />\n                    </HBox>\n                    <ProgressBar fx:id=\"pbMed\" maxWidth=\"Infinity\" progress=\"0.0\" style=\"-fx-pref-height: 5; -fx-background-radius: 3;\" styleClass=\"progress-amber\" />\n                    <HBox alignment=\"CENTER_LEFT\">\n                        <Label style=\"-fx-text-fill: #9ca3af; -fx-font-size: 10px;\" styleClass=\"resource-label\" text=\"Evac Center Cap.\" />\n                        <Region HBox.hgrow=\"ALWAYS\" />\n                        <Label fx:id=\"lblEvacCapPct\" style=\"-fx-text-fill: #6b7280; -fx-font-size: 10px;\" styleClass=\"resource-pct\" text=\"—\" />\n                    </HBox>\n                    <ProgressBar fx:id=\"pbEvacCap\" maxWidth=\"Infinity\" progress=\"0.0\" style=\"-fx-pref-height: 5; -fx-background-radius: 3;\" styleClass=\"progress-blue\" />\n                </VBox>\n\n                <TableView fx:id=\"tblResources\" style=\"-fx-background-color: #161b22; -fx-border-color: transparent; -fx-table-cell-border-color: #21262d; -fx-font-size: 10px;\" styleClass=\"incident-table\" VBox.vgrow=\"ALWAYS\">\n                    <columns>\n                        <TableColumn fx:id=\"colResourceType\" prefWidth=\"140\" text=\"Resource\">\n                            <cellValueFactory><PropertyValueFactory property=\"resourceType\" /></cellValueFactory>\n                        </TableColumn>\n                        <TableColumn fx:id=\"colResourceQuantity\" prefWidth=\"55\" text=\"Qty\">\n                            <cellValueFactory><PropertyValueFactory property=\"quantity\" /></cellValueFactory>\n                        </TableColumn>\n                        <TableColumn fx:id=\"colResourceStatus\" prefWidth=\"130\" text=\"Status\">\n                            <cellValueFactory><PropertyValueFactory property=\"status\" /></cellValueFactory>\n                        </TableColumn>\n                    </columns>\n                    <placeholder>\n                        <Label style=\"-fx-text-fill: #4b5563; -fx-font-size: 11px;\" text=\"No resources loaded.\" />\n                    </placeholder>\n                </TableView>\n            </VBox>\n\n        </VBox>\n    </right>\n\n    <!-- ============================================================ -->\n    <!-- BOTTOM: LOGS + ANALYTICS + STAT CARDS PANEL                  -->\n    <!-- ============================================================ -->\n    <bottom>\n        <HBox prefHeight=\"225\" style=\"-fx-background-color: #161b22; -fx-border-color: #21262d; -fx-border-width: 1 0 0 0;\">\n\n            <!-- LEFT: Incident Logs -->\n            <VBox prefWidth=\"430\" style=\"-fx-border-color: #21262d; -fx-border-width: 0 1 0 0;\">\n                <HBox alignment=\"CENTER_LEFT\" spacing=\"8\" style=\"-fx-padding: 8 14 8 14; -fx-background-color: #1f293