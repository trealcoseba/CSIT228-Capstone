<+><?xml version=\"1.0\" encoding=\"UTF-8\"?>\n\n<?import javafx.geometry.*?>\n<?import javafx.scene.control.*?>\n<?import javafx.scene.layout.*?>\n\n<ScrollPane fx:id=\"mainContent\" fitToWidth=\"true\" prefHeight=\"800.0\" prefWidth=\"1000.0\" styleClass=\"dashboard-scroll\" stylesheets=\"@../../../../css/application.css\" xmlns=\"http://javafx.com/javafx/17.0.12\" xmlns:fx=\"http://javafx.com/fxml/1\" fx:controller=\"com.example.csit228capstone.controller.dashboard.DashboardController\">\n\n    <VBox alignment=\"TOP_CENTER\" spacing=\"24\">\n        <padding><Insets topRightBottomLeft=\"16\" /></padding>\n\n        <!-- ── KPI Cards Row ─────────────────────────────────────────────────── -->\n        <HBox fx:id=\"kpiRow\" spacing=\"16\">\n            <VBox styleClass=\"kpi-card\" HBox.hgrow=\"ALWAYS\">\n                <Label styleClass=\"kpi-label\" text=\"Total Residents\" />\n                <Label fx:id=\"lblTotalResidents\" styleClass=\"kpi-value\" text=\"0\" />\n                <Label styleClass=\"kpi-sub\" text=\"Registered in system\" />\n            </VBox>\n            <VBox styleClass=\"kpi-card, kpi-danger\" HBox.hgrow=\"ALWAYS\">\n                <Label styleClass=\"kpi-label\" text=\"Active Incidents\" />\n                <Label fx:id=\"lblActiveIncidents\" styleClass=\"kpi-value\" text=\"0\" />\n                <Label styleClass=\"kpi-sub\" text=\"Require attention\" />\n            </VBox>\n            <VBox styleClass=\"kpi-card, kpi-info\" HBox.hgrow=\"ALWAYS\">\n                <Label styleClass=\"kpi-label\" text=\"Evacuees\" />\n                <Label fx:id=\"lblEvacuees\" styleClass=\"kpi-value\" text=\"0\" />\n                <Label styleClass=\"kpi-sub\" text=\"Currently sheltered\" />\n            </VBox>\n        </HBox>\n\n        <!-- ── Middle Row: Incident Monitor + Quick Actions ─────────────────── -->\n        <HBox spacing=\"16\">\n\n            <!-- Live Incident Monitor -->\n            <VBox styleClass=\"panel-card\" HBox.hgrow=\"ALWAYS\">\n                <HBox alignment=\"CENTER_LEFT\" spacing=\"8\">\n                    <Label styleClass=\"panel-title\" text=\"Live Incident Monitor\" />\n                    <Region HBox.hgrow=\"ALWAYS\" />\n                    <Hyperlink onAction=\"#viewAllIncidents\" styleClass=\"panel-link\" text=\"View all →\" />\n                </HBox>\n                <TableView fx:id=\"incidentTable\" prefHeight=\"250\" styleClass=\"incident-table\" VBox.vgrow=\"ALWAYS\">\n                    <columns>\n                        <TableColumn fx:id=\"colSeverity\" prefWidth=\"30\" text=\"\" />\n                        <TableColumn fx:id=\"colType\" prefWidth=\"140\" text=\"Incident\" />\n                        <TableColumn fx:id=\"colLocation\" prefWidth=\"130\" text=\"Location\" />\n                        <TableColumn fx:id=\"colTime\" prefWidth=\"80\" text=\"Time\" />\n                        <TableColumn fx:id=\"colStatus\" prefWidth=\"100\" text=\"Status\" />\n                    </columns>\n                    <columnResizePolicy>\n                        <TableView fx:constant=\"CONSTRAINED_RESIZE_POLICY\" />\n                    </columnResizePolicy>\n                </TableView>\n            </VBox>\n\n            <!-- Quick Actions -->\n            <VBox prefWidth=\"200\" spacing=\"12\" styleClass=\"panel-card\">\n                <Label styleClass=\"panel-title\" text=\"Quick Actions\" />\n                <Button maxWidth=\"Infinity\" onAction=\"#reportIncident\" styleClass=\"quick-action-btn, qa-danger\" text=\"Report Incident\" />\n                <Button maxWidth=\"Infinity\" onAction=\"#evacuationCenter\" styleClass=\"quick-action-btn, qa-warning\" text=\"Evacuation Center\" />\n                <Button maxWidth=\"Infinity\" onAction=\"#addResident\" styleClass=\"quick-action-btn\" text=\"Add Resident\" />\n            </VBox>\n        </HBox>\n\n        <!-- ── Bottom Row: Resources + Vulnerable + Weather ─────────────────── -->\n        <HBox spacing=\"16\">\n\n            <!-- Resource Status — driven by ResourceRepository -->\n            <VBox spacing=\"12\" styleClass=\"panel-card\" HBox.hgrow=\"ALWAYS\">\n                <Label styleClass=\"panel-title\" text=\"Resource Status\" />\n                <VBox spacing=\"8\">\n                    <!-- Relief Goods -->\n                    <HBox alignment=\"CENTER_LEFT\">\n                        <Label styleClass=\"resource-label\" text=\"Relief Goods\" />\n                        <Region HBox.hgrow=\"ALWAYS\" />\n                        <Label fx:id=\"lblRelief\" styleClass=\"resource-pct\" text=\"–%\" />\n                    </HBox>\n                    <ProgressBar fx:id=\"pbRelief\" maxWidth=\"Infinity\" progress=\"0\" styleClass=\"progress-green\" />\n\n                    <!-- Medical -->\n                    <HBox alignment=\"CENTER_LEFT\">\n                        <Label styleClass=\"resource-label\" text=\"Medical\" />\n                        <Region HBox.hgrow=\"ALWAYS\" />\n                        <Label fx:id=\"lblMed\" styleClass=\"resource-pct\" text=\"–%\" />\n                    </HBox>\n                    <ProgressBar fx:id=\"pbMed\" maxWidth=\"Infinity\" progress=\"0\" styleClass=\"progress-amber\" />\n\n                    <!-- Emergency Fund -->\n                    <HBox alignment=\"CENTER_LEFT\">\n                        <Label styleClass=\"resource-label\" text=\"Emergency Fund\" />\n                        <Region HBox.hgrow=\"ALWAYS\" />\n                        <Label fx:id=\"lblFund\" styleClass=\"resource-pct\" text=\"–%\" />\n                    </HBox>\n                    <ProgressBar fx:id=\"pbFund\" maxWidth=\"Infinity\" progress=\"0\" styleClass=\"progress-red\" />\n\n                    <!-- Evacuation -->\n                    <HBox alignment=\"CENTER_LEFT\">\n                        <Label styleClass=\"resource-label\" text=\"Evacuation\" />\n                        <Region HBox.hgrow=\"ALWAYS\" />\n                        <Label fx:id=\"lblEvac\" styleClass=\"resource-pct\" text=\"–%\" />\n                    </HBox>\n                    <ProgressBar fx:id=\"pbEvac\" maxWidth=\"Infinity\" progress=\"0\" styleClass=\"progress-blue\" />\n                </VBox>\n            </VBox>\n\n            <!-- Vulnerable Residents -->\n            <VBox spacing=\"12\" styleClass=\"panel-card\" HBox.hgrow=\"ALWAYS\">\n                <Label styleClass=\"panel-title\" text=\"Vulnerable Residents\" />\n                <HBox alignment=\"CENTER_LEFT\" spacing=\"90.0\">\n                    <VBox alignment=\"CENTER_LEFT\" prefHeight=\"52.0\" prefWidth=\"72.0\">\n                        <Label fx:id=\"lblSenior\" styleClass=\"vuln-count\" text=\"–\" textFill=\"#bf5d5d\" />\n                        <Label styleClass=\"vuln-label\" text=\"Senior Citizens\" />\n                    </VBox>\n                    <VBox alignment=\"CENTER_LEFT\" prefHeight=\"52.0\" prefWidth=\"44.0\" spacing=\"4\">\n                        <Label fx:id=\"lblPwd\" styleClass=\"vuln-count\" text=\"–\">\n                     <VBox.margin>\n                        <Insets />\n                     </VBox.margin></Label>\n                        <Label styleClass=\"vuln-label\" text=\"PWD\" />\n                  <HBox.margin>\n                     <Insets left=\"-23.0\" />\n                  </HBox.margin>\n                    </VBox>\n                    <VBox alignment=\"CENTER_LEFT\" spacing=\"4\">\n                        <Label fx:id=\"lblIndigenous\" styleClass=\"vuln-count\" text=\"–\" />\n                        <Label styleClass=\"vuln-label\" text=\"Indigenous\" />\n                    </VBox>\n                    <VBox.margin><Insets /></VBox.margin>\n                    <padding><Insets left=\"15.0\" /></padding>\n                </HBox>\n                <HBox alignment=\"CENTER_LEFT\" spacing=\"73.0\">\n                    <VBox alignment=\"CENTER_LEFT\" prefWidth=\"66.0\" spacing=\"4\">\n                        <Label fx:id=\"lblPregnant\" styleClass=\"vuln-count\" text=\"–\" />\n                        <Label styleClass=\"vuln-label\" text=\"Pregnant\" />\n                    </VBox>\n                    <VBox alignment=\"CENTER_LEFT\" spacing=\"4\">\n                        <Label fx:id=\"lblChildren\" styleClass=\"vuln-count\" text=\"–\" />\n                        <Label styleClass=\"vuln-label\" text=\"Children (0-5)\" />\n                    </VBox>\n                    <VBox alignment=\"CENTER_LEFT\" spacing=\"4\">\n                        <Label fx:id=\"lblSoloParent\" styleClass=\"vuln-count\" text=\"–\" />\n                        <Label styleClass=\"vuln-label\" text=\"Solo Parent\" />\n                    </VBox>\n                    <padding><Insets left=\"15.0\" top=\"15.0\" /></padding>\n                </HBox>\n            </VBox>\n\n            <!-- Weather Widget — populated by OpenWeatherMap API -->\n            <VBox prefWidth=\"220\" spacing=\"4\" styleClass=\"panel-card, weather-card\">\n                <Label fx:id=\"lblWeatherTemp\" styleClass=\"weather-temp\" text=\"--°C\" />\n                <HBox spacing=\"16\">\n                    <VBox>\n                        <Label fx:id=\"lblHumidity\" styleClass=\"weather-stat\" text=\"--%\" />\n                        <Label styleClass=\"weather-stat-label\" text=\"Humidity\" />\n                    </VBox>\n                    <VBox>\n                        <Label fx:id=\"lblWind\" styleClass=\"weather-stat\" text=\"-- kph\" />\n                        <Label styleClass=\"weather-stat-label\" text=\"Wind\" />\n                    </VBox>\n                </HBox>\n                <Label fx:id=\"lblWeatherDesc\" styleClass=\"weather-desc\" text=\"Loading… · Bacolod City\" />\n            </VBox>\n\n        </HBox>\n    </VBox>\n</ScrollPane>\n
