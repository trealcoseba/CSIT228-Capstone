<+><!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>LIGTAS-Brgy Unified Map</title>\n    <link rel=\"stylesheet\" href=\"https://unpkg.com/leaflet@1.9.4/dist/leaflet.css\"/>\n    <script src=\"https://unpkg.com/leaflet@1.9.4/dist/leaflet.js\"></script>\n    <style>\n        body, html, #map { margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden; background: #E5E0D8; }\n    </style>\n</head>\n<body>\n<div id=\"map\"></div>\n<script>\n    // Initialize map centering on Bacolod City (LIGTAS-Brgy project location)\n    const map = L.map('map', { zoomControl: true }).setView([10.3077, 123.8941], 14);\n\n    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {\n        maxZoom: 19,\n        attribution: '&copy; OpenStreetMap'\n    }).addTo(map);\n\n    let markerLayerGroup = L.layerGroup().addTo(map);\n    let selectionMarker = null;\n\n    // --- USE CASE 1: RESIDENT PINNING (Reverse Geocoding) ---\n    map.on('click', async function(e) {\n        const { lat, lng } = e.latlng;\n\n        // Update visual marker\n        if (selectionMarker) {\n            selectionMarker.setLatLng(e.latlng);\n        } else {\n            selectionMarker = L.marker(e.latlng, { draggable: true }).addTo(map);\n        }\n\n        // Fetch actual address using Nominatim (Free)\n        try {\n            const response = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}`, {\n                headers: { 'User-Agent': 'LIGTAS-Brgy-Capstone' }\n            });\n            const data = await response.json();\n            const address = data.display_name || `Lat: ${lat.toFixed(5)}, Lng: ${lng.toFixed(5)}`;\n\n            // Send back to Java Controller (MapPickerController)\n            if (window.javaConnector) {\n                window.javaConnector.setAddress(address, lat, lng);\n            }\n        } catch (error) {\n            window.javaConnector.setAddress(`Lat: ${lat.toFixed(5)}, Lng: ${lng.toFixed(5)}`, lat, lng);\n        }\n    });\n\n    // --- USE CASE 2: EVACUATION CENTER DISPLAY ---\n    function clearMarkers() {\n        markerLayerGroup.clearLayers();\n    }\n\n    function addCenterMarker(id, lat, lng, name, occupancy, capacity, isActive, status) {\n        let color, borderColor;\n\n        // Status Logic: Red for Inactive, Yellow for Full, Green for Active\n        if (!isActive || status === 'Inactive') {\n            color = '#6b7280';       // Red\n            borderColor = '#4b5563';\n        } else if (status === 'Full') {\n            color = '#ef4444';       // Yellow/Amber\n            borderColor = '#dc2626';\n        } else {\n            color = '#22c55e';       // Green\n            borderColor = '#16a34a';\n        }\n\n        const percent = capacity > 0 ? Math.round((occupancy / capacity) * 100) : 0;\n\n        // Progress Bar Logic: Green < 90%, Yellow 90-100%, Red > 100%\n        let barColor = '#22c55e'; // Default Green\n        if (percent >= 90 && percent <= 100) {\n            barColor = '#f59e0b'; // Yellow\n        } else if (percent > 100) {\n            barColor = '#ef4444'; // Red\n        }\n\n        const statusLabel = !isActive ? 'Inactive'\n            : status === 'Full' ? 'Full'\n                : 'Available';\n\n        const icon = L.divIcon({\n            className: '',\n            html: `\n            <div style=\"\n                position: relative;\n                display: flex;\n                flex-direction: column;\n                align-items: center;\n            \">\n                <div style=\"\n                    background: ${color};\n                    border: 3px solid ${borderColor};\n                    border-radius: 50% 50% 50% 0;\n                    transform: rotate(-45deg);\n                    width: 28px;\n                    height: 28px;\n                    box-shadow: 0 2px 6px rgba(0,0,0,0.35);\n                    display: flex;\n                    align-items: center;\n                    justify-content: center;\n                \">\n                    <div style=\"\n                        transform: rotate(45deg);\n                        color: white;\n                        font-size: 11px;\n                        font-weight: bold;\n                        line-height: 1;\n                    \">A</div>\n                </div>\n                <div style=\"\n                    width: 4px;\n                    height: 6px;\n                    background: ${borderColor};\n                    margin-top: -1px;\n                \"></div>\n            </div>`,\n            iconSize: [28, 40],\n            iconAnchor: [14, 40],\n            popupAnchor: [0, -42]\n        });\n\n        const marker = L.marker([lat, lng], { icon });\n\n        marker.bindPopup(`\n        <div style=\"\n            font-family: sans-serif;\n            min-width: 180px;\n            padding: 4px;\n        \">\n            <div style=\"\n                font-size: 14px;\n                font-weight: 700;\n                color: #111827;\n                margin-bottom: 6px;\n            \">${name}</div>\n\n            <div style=\"\n                display: inline-block;\n                padding: 2px 10px;\n                border-radius: 12px;\n                font-size: 11px;\n                font-weight: 600;\n                background: ${color}22;\n                color: ${color};\n                border: 1px solid ${color};\n                margin-bottom: 8px;\n            \">${statusLabel}</div>\n\n            <div style=\"margin-bottom: 4px;\">\n                <div style=\"\n                    display: flex;\n                    justify-content: space-between;\n                    font-size: 11px;\n                    color: #6b7280;\n                    margin-bottom: 2px;\n                \">\n                    <span>Occupancy</span>\n                    <span>${occupancy} / ${capacity}</span>\n                </div>\n                <div style=\"\n                    width: 100%;\n                    height: 6px;\n                    background: #e5e7eb;\n                    border-radius: 99px;\n                    overflow: hidden;\n                \">\n                    <div style=\"\n                        width: ${Math.min(percent, 100)}%;\n                        height: 100%;\n                        background: ${barColor};\n                        border-radius: 99px;\n                        transition: width 0.3s;\n                    \"></div>\n                </div>\n            </div>\n\n            <div style=\"\n                font-size: 11px;\n                color: #9ca3af;\n                text-align: right;\n                margin-top: 4px;\n            \">${percent}% filled</div>\n        </div>\n    `);\n\n        markerLayerGroup.addLayer(marker);\n    }\n\n    // Fix for JavaFX \"Grey Box\" rendering issue\n    function fixMapSize() {\n        setTimeout(() => {\n            map.invalidateSize();\n            // Update this line to match CIT-U as well\n            map.setView([10.3077, 123.8941], 15, { animate: false });\n        }, 300);\n    }\n\n    async function searchAddress(query) {\n        try {\n            const response = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${query}`);\n            const data = await response.json();\n            if (data && data.length > 0) {\n                const result = data[0];\n                const lat = parseFloat(result.lat);\n                const lon = parseFloat(result.lon);\n\n                // Move map and marker\n                map.flyTo([lat, lon], 17);\n                if (selectionMarker) {\n                    selectionMarker.setLatLng([lat, lon]);\n                } else {\n                    selectionMarker = L.marker([lat, lon]).addTo(map);\n                }\n\n                // Update Java side with the \"official\" formatted address\n                window.javaConnector.setAddress(result.display_name, lat, lon);\n            }\n        } catch (e) {\n            console.error(\"Search failed\", e);\n        }\n    }\n\n    // Center view on specific coordinates (For focusing on a center)\n    function focusLocation(lat, lng) {\n        map.flyTo([lat, lng], 17);\n    }\n</script>\n</body>\n</html>
