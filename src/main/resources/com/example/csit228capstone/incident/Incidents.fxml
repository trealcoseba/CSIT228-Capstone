<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" prefHeight="800.0" prefWidth="1000.0" styleClass="dashboard-scroll" stylesheets="@../../../../css/application.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.csit228capstone.controller.incidents.IncidentsController">
    <VBox spacing="16">
        <padding><Insets topRightBottomLeft="16" /></padding>

        <!-- Header with Title and Actions -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label styleClass="page-title" text="Incidents Management" />
            <Region HBox.hgrow="ALWAYS" />
            <TextField prefWidth="200" promptText="🔍 Search incidents..." styleClass="search-field" />
            <Button onAction="#openNewIncident" styleClass="quick-action-btn" text="➕ New Incident" />
        </HBox>

        <!-- Filters -->
        <HBox spacing="12" styleClass="filter-bar">
            <Label styleClass="filter-label" text="Filter:" />
            <ComboBox fx:id="filterSeverity" prefWidth="120" promptText="Severity" />
            <ComboBox fx:id="filterStatus" prefWidth="120" promptText="Status" />
            <ComboBox fx:id="filterType" prefWidth="120" promptText="Type" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#resetFilters" styleClass="quick-action-btn" text="Reset Filters" />
        </HBox>

        <!-- Incidents Table -->
        <VBox spacing="12" styleClass="panel-card" VBox.vgrow="ALWAYS">
            <Label styleClass="panel-title" text="Active Incidents" />
            <TableView fx:id="incidentsTable" prefHeight="400" styleClass="incident-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="50" text="ID" />
                    <TableColumn fx:id="colType" prefWidth="100" text="Type" />
                    <TableColumn fx:id="colLocation" prefWidth="150" text="Location" />
                    <TableColumn fx:id="colReporter" prefWidth="100" text="Reporter" />
                    <TableColumn fx:id="colSeverity" prefWidth="80" text="Severity" />
                    <TableColumn fx:id="colStatus" prefWidth="100" text="Status" />
                    <TableColumn fx:id="colTime" prefWidth="120" text="Time Reported" />
                    <TableColumn fx:id="colActions" prefWidth="80" text="Actions" />
                </columns>
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            </TableView>
        </VBox>

        <!-- Stats Row -->
        <HBox spacing="16">
            <VBox styleClass="kpi-card, kpi-danger" HBox.hgrow="ALWAYS">
                <Label styleClass="kpi-label" text="Critical Incidents" />
                <Label fx:id="lblCritical" styleClass="kpi-value" text="0" />
            </VBox>
            <VBox styleClass="kpi-card, kpi-warning" HBox.hgrow="ALWAYS">
                <Label styleClass="kpi-label" text="Ongoing" />
                <Label fx:id="lblOngoing" styleClass="kpi-value" text="0" />
            </VBox>
            <VBox styleClass="kpi-card, kpi-info" HBox.hgrow="ALWAYS">
                <Label styleClass="kpi-label" text="Resolved Today" />
                <Label fx:id="lblResolved" styleClass="kpi-value" text="0" />
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>
