<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.*?>

<VBox spacing="0"
      style="-fx-background-color: #0d1117;"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.csit228capstone.controller.emergency.TriggerEmergencyController">

    <HBox alignment="CENTER_LEFT" spacing="10"
          style="-fx-padding: 14 20 14 20; -fx-background-color: #ff4757;">
        <Label style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"
               text="⚠  DECLARE EMERGENCY INCIDENT" />
    </HBox>

    <HBox spacing="0" VBox.vgrow="ALWAYS">

        <VBox spacing="16" prefWidth="360"
              style="-fx-padding: 22 22 22 22; -fx-background-color: #161b22;
                     -fx-border-color: #21262d; -fx-border-width: 0 1 0 0;">

            <VBox spacing="5">
                <Label style="-fx-text-fill: #9ca3af; -fx-font-size: 10px; -fx-font-weight: bold;"
                       text="INCIDENT TYPE *" />
                <ComboBox fx:id="cbIncidentType" maxWidth="Infinity"
                          promptText="Select incident type…"
                          style="-fx-background-color: #1f2937; -fx-text-fill: white; -fx-mark-color: white;
                                 -fx-border-color: #374151; -fx-border-radius: 6;
                                 -fx-background-radius: 6; -fx-font-size: 13px;" />
            </VBox>

            <VBox spacing="5">
                <Label style="-fx-text-fill: #9ca3af; -fx-font-size: 10px; -fx-font-weight: bold;"
                       text="SEVERITY *" />
                <ComboBox fx:id="cbSeverity" maxWidth="Infinity"
                          promptText="Select severity level…"
                          style="-fx-background-color: #1f2937; -fx-text-fill: white; -fx-mark-color: white;
                                 -fx-border-color: #374151; -fx-border-radius: 6;
                                 -fx-background-radius: 6; -fx-font-size: 13px;" />
            </VBox>

            <VBox spacing="5">
                <Label style="-fx-text-fill: #9ca3af; -fx-font-size: 10px; -fx-font-weight: bold;"
                       text="AFFECTED RADIUS (meters) *" />
                <TextField fx:id="txtRadius"
                           promptText="e.g. 500"
                           style="-fx-background-color: #1f2937; -fx-text-fill: #f9fafb;
                                  -fx-border-color: #374151; -fx-border-radius: 6;
                                  -fx-background-radius: 6; -fx-font-size: 13px;
                                  -fx-padding: 8 12 8 12;" />
            </VBox>

            <VBox spacing="5">
                <Label style="-fx-text-fill: #9ca3af; -fx-font-size: 10px; -fx-font-weight: bold;"
                       text="INCIDENT TITLE (optional)" />
                <TextField fx:id="txtTitle"
                           promptText="Leave blank to auto-generate"
                           style="-fx-background-color: #1f2937; -fx-text-fill: #f9fafb;
                                  -fx-border-color: #374151; -fx-border-radius: 6;
                                  -fx-background-radius: 6; -fx-font-size: 13px;
                                  -fx-padding: 8 12 8 12;" />
            </VBox>

            <VBox spacing="5" VBox.vgrow="ALWAYS">
                <Label style="-fx-text-fill: #9ca3af; -fx-font-size: 10px; -fx-font-weight: bold;"
                       text="DESCRIPTION (optional)" />
                <TextArea fx:id="txtDescription"
                          promptText="Brief description of the incident…"
                          prefHeight="80" wrapText="true"
                          style="-fx-background-color: #1f2937; -fx-text-fill: black;
                                 -fx-border-color: #374151; -fx-border-radius: 6;
                                 -fx-background-radius: 6; -fx-font-size: 12px;" />
            </VBox>

            <VBox spacing="5">
                <Label style="-fx-text-fill: #9ca3af; -fx-font-size: 10px; -fx-font-weight: bold;"
                       text="INCIDENT COORDINATES" />
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label fx:id="lblLatLng"
                           style="-fx-text-fill: #60a5fa; -fx-font-size: 12px;
                                  -fx-font-family: 'Courier New';
                                  -fx-background-color: #1e3a5f; -fx-background-radius: 6;
                                  -fx-padding: 6 12 6 12;" HBox.hgrow="ALWAYS"
                           maxWidth="Infinity"
                           text="Not pinned yet — use map →" />
                    <Button fx:id="btnPickLocation" onAction="#handlePickLocation"
                            text="📍 Pin"
                            style="-fx-background-color: #1d4ed8; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-font-size: 12px;
                                   -fx-background-radius: 6; -fx-padding: 8 14 8 14;
                                   -fx-cursor: hand;" />
                </HBox>
            </VBox>

        </VBox>

        <VBox VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS"
              style="-fx-background-color: #0d1117;">
            <HBox alignment="CENTER_LEFT" spacing="8"
                  style="-fx-padding: 10 14 10 14; -fx-background-color: #1f2937;
                         -fx-border-color: #21262d; -fx-border-width: 0 0 1 0;">
                <Label style="-fx-text-fill: #f9fafb; -fx-font-size: 11px; -fx-font-weight: bold;"
                       text="INCIDENT LOCATION PREVIEW" />
                <Label style="-fx-text-fill: #6b7280; -fx-font-size: 10px;"
                       text="— Pin a location to preview the affected radius" />
            </HBox>
            <WebView fx:id="previewMap" VBox.vgrow="ALWAYS" />
        </VBox>

    </HBox>

    <HBox alignment="CENTER_RIGHT" spacing="10"
          style="-fx-padding: 14 20 14 20; -fx-background-color: #161b22;
                 -fx-border-color: #21262d; -fx-border-width: 1 0 0 0;">
        <Label fx:id="lblValidationError"
               style="-fx-text-fill: #ff4757; -fx-font-size: 11px;" text="" HBox.hgrow="ALWAYS" />
        <Button onAction="#handleCancel" text="Cancel"
                style="-fx-background-color: transparent; -fx-text-fill: #9ca3af;
                       -fx-border-color: #374151; -fx-border-radius: 8;
                       -fx-background-radius: 8; -fx-font-size: 13px;
                       -fx-padding: 9 20 9 20; -fx-cursor: hand;" />
        <Button fx:id="btnDeclare" onAction="#handleDeclare" text="🚨 Declare Emergency"
                style="-fx-background-color: #dc2626; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-font-size: 13px;
                       -fx-background-radius: 8; -fx-padding: 9 22 9 22;
                       -fx-cursor: hand;" />
    </HBox>

</VBox>
