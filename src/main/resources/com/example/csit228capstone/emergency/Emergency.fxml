<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.*?>

<BorderPane prefHeight="900" prefWidth="1440" style="-fx-background-color: #0d1117;" styleClass="root-pane" stylesheets="@../../../../css/application.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.csit228capstone.controller.emergency.EmergencyController">

    <!-- ============================================================ -->
    <!-- TOP: INCIDENT OVERVIEW PANEL                                  -->
    <!-- ============================================================ -->
    <top>
        <VBox style="-fx-background-color: #161b22; -fx-border-color: #ff4757; -fx-border-width: 0 0 2 0;">

            <!-- Command Bar — styled like top-bar from dashboard -->
            <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 9 16 9 16; -fx-background-color: #ff4757;">
                <Label style="-fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold;" styleClass="brand-title" text="⚠  LIGTAS-BRGY — EMERGENCY OPERATIONS CENTER" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblSystemTime" style="-fx-text-fill: white; -fx-font-size: 12px; -fx-font-family: 'Courier New';" text="--:--:--" />
                <Label style="-fx-text-fill: #00ff88; -fx-font-size: 10px;" text="●" />
                <Label style="-fx-text-fill: #00ff88; -fx-font-size: 11px; -fx-font-weight: bold;" styleClass="active-incidents-badge" text="LIVE" />
            </HBox>

            <!-- KPI / Incident Detail Cards Row — mirrors kpiRow from dashboard -->
            <HBox fx:id="incidentKpiRow" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 12 16 12 16;">

                <!-- Emergency Type -->
                <VBox style="-fx-background-color: #1f2937; -fx-min-width: 155; -fx-padding: 10 16 10 16; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: rgba(192,57,43,0.35); -fx-border-width: 1;" styleClass="kpi-card, kpi-danger">
                    <Label style="-fx-text-fill: #6b7280; -fx-font-size: 9px; -fx-font-weight: bold;" styleClass="kpi-label" text="EMERGENCY TYPE" />
                    <Label fx:id="lblEmergencyType" style="-fx-text-fill: #ff4757; -fx-font-size: 15px; -fx-font-weight: bold;" styleClass="kpi-value" text="—" />
                    <Label style="-fx-text-fill: #4b5563; -fx-font-size: 9px;" styleClass="kpi-sub" text="Active incident" />
                </VBox>

                <!-- Severity Badge -->
                <VBox style="-fx-background-color: #1f2937; -fx-min-width: 125; -fx-padding: 10 16 10 16; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #21262d; -fx-border-width: 1;" styleClass="kpi-card">
                    <Label style="-fx-text-fill: #6b7280; -fx-font-size: 9px; -fx-font-weight: bold;" styleClass="kpi-label" text="SEVERITY" />
                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <Label fx:id="lblSeverityDot" style="-fx-text-fill: #ff4757; -fx-font-size: 12px;" text="●" />
                        <Label fx:id="lblSeverity" style="-fx-text-fill: #f9fafb; -fx-font-size: 15px; -fx-font-weight: bold;" styleClass="kpi-value" text="—" />
                    </HBox>
                    <Label style="-fx-text-fill: #4b5563; -fx-font-size: 9px;" styleClass="kpi-sub" text="Threat level" />
                </VBox>

                <!-- Timestamp -->
                <VBox style="-fx-background-color: #1f2937; -fx-min-width: 180; -fx-padding: 10 16 10 16; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #21262d; -fx-border-width: 1;" styleClass="kpi-card">
                    <Label style="-fx-text-fill: #6b7280; -fx-font-size: 9px; -fx-font-weight: bold;" styleClass="kpi-label" text="TIMESTAMP" />
                    <Label fx:id="lblTimestamp" style="-fx-text-fill: #f9fafb; -fx-font-size: 13px; -fx-font-family: 'Courier New';" text="—" />
                    <Label style="-fx-text-fill: #4b5563; -fx-font-size: 9px;" styleClass="kpi-sub" text="Incident reported" />
                </VBox>

                <!-- Status Indicator -->
                <VBox style="-fx-background-color: #1f2937; -fx-min-width: 125; -fx-padding: 10 16 10 16; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #21262d; -fx-border-width: 1;" styleClass="kpi-card">
                    <Label style="-fx-text-fill: #6b7280; -fx-font-size: 9px; -fx-font-weight: bold;" styleClass="kpi-label" text="STATUS" />
                    <Label fx:id="lblStatus" style="-fx-text-fill: #fbbf24; -fx-font-size: 13px; -fx-font-weight: bold;" text="—" />
                    <Label style="-fx-text-fill: #4b5563; -fx-font-size: 9px;" styleClass="kpi-sub" text="Response state" />
                </VBox>

                <!-- Incident Coordinates -->
                <VBox minWidth="188.0" prefHeight="63.0" prefWidth="188.0" style="-fx-background-color: #1f2937; -fx-min-width: 200; -fx-padding: 10 16 10 16; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: rgba(52,152,219,0.25); -fx-border-width: 1;" styleClass="kpi-card, kpi-info">
                    <Label style="-fx-text-fill: #6b7280; -fx-font-size: 9px; -fx-font-weight: bold;" styleClass="kpi-label" text="INCIDENT COORDINATES" />
                    <Label fx:id="lblCoordinates" style="-fx-text-fill: #60a5fa; -fx-font-size: 13px; -fx-font-family: 'Courier New';" text="—" />
                    <Label style="-fx-text-fill: #4b5563; -fx-font-size: 9px;" styleClass="kpi-sub" text="GPS location" />
                </VBox>

                <!-- Affected Radius -->
                <VBox style="-fx-background-color: #1f2937; -fx-min-width: 125; -fx-padding: 10 16 10 16; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #21262d; -fx-border-width: 1;" styleClass="kpi-card">
                    <Label style="-fx-text-fill: #6b7280; -fx-font-size: 9px; -fx-font-weight: bold;" styleClass="kpi-label" text="AFFECTED RADIUS" />
                    <Label fx:id="lblAffectedRadius" style="-fx-text-fill: #f9fafb; -fx-font-size: 15px; -fx-font-weight: bold;" styleClass="kpi-value" text="—" />
                    <Label style="-fx-text-fill: #4b5563; -fx-font-size: 9px;" styleClass="kpi-sub" text="Impact zone" />
                </VBox>

                <Region prefHeight="63.0" prefWidth="0.0" HBox.hgrow="ALWAYS" />

                <!-- Action Buttons — styled like quick-action-btn -->
                <HBox alignment="CENTER_RIGHT" spacing="8">
                    <Button fx:id="btnActivateDispatch" onAction="#assignDispatch" prefHeight="46.0" prefWidth="119.0" style="-fx-font-size: 12px; -fx-padding: 8 14 8 14;" styleClass="quick-action-btn, qa-danger" text="Activate &#10;Dispatch" />
                    <Button fx:id="btnNotifyResidents" onAction="#notifyResidents" prefHeight="48.0" prefWidth="85.0" style="-fx-font-size: 12px; -fx-padding: 8 14 8 14;" styleClass="quick-action-btn, qa-warning" text="Notify&#10; Residents" textAlignment="CENTER" />
                    <Button fx:id="btnRefreshData" onAction="#refreshDashboard" style="-fx-font-size: 12px; -fx-padding: 8 14 8 14; -fx-text-fill: #9ca3af; -fx-border-color: #374151;" styleClass="btn-outline" text="Refresh" />
                    <Button fx:id="btnEndEmergency" onAction="#endEmergency" style="-fx-background-color: #111827; -fx-text-fill: #ef4444; -fx-font-weight: bold; -fx-font-size: 12px; -fx-background-radius: 8; -fx-padding: 8 14 8 14; -fx-cursor: hand; -fx-border-color: #ef4444; -fx-border-radius: 8;" text="End Emergency" />
                </HBox>

            </HBox>
        </VBox>
    </top>

    <!-- ============================================================ -->
    <!-- LEFT: RESIDENTS PRIORITY PANEL                                -->
    <!-- ============================================================ -->
    <left>
        <VBox prefWidth="315" spacing="0" style="-fx-background-color: #161b22; -fx-border-color: #21262d; -fx-border-width: 0 1 0 0;">

            <!-- Priority Residents Header — panel-card style header -->
            <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 10 14 10 14; -fx-background-color: #1f2937; -fx-border-color: #21262d; -fx-border-width: 0 0 1 0;">
                <Label style="-fx-text-fill: #f9fafb; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 0;" styleClass="panel-title" text="PRIORITY RESIDENTS" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblResidentCount" style="-fx-text-fill: #60a5fa; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-color: #1e3a5f; -fx-background-radius: 10; -fx-padding: 2 8 2 8;" text="0" />
            </HBox>

            <!-- Priority Legend — clean pill-style like status badges -->
            <HBox spacing="10" style="-fx-padding: 6 14 2 14; -fx-background-color: #161b22;">
                <HBox alignment="CENTER_LEFT" spacing="4" style="-fx-background-color: rgba(192,57,43,0.12); -fx-background-radius: 10; -fx-padding: 3 8 3 8;">
                    <Label style="-fx-text-fill: #ff4757; -fx-font-size: 8px;" text="●" />
                    <Label style="-fx-text-fill: #ff4757; -fx-font-size: 9px; -fx-font-weight: bold;" text="P1: Vulnerable" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="4" style="-fx-background-color: rgba(52,152,219,0.12); -fx-background-radius: 10; -fx-padding: 3 8 3 8;">
                    <Label style="-fx-text-fill: #60a5fa; -fx-font-size: 8px;" text="●" />
                    <Label style="-fx-text-fill: #60a5fa; -fx-font-size: 9px; -fx-font-weight: bold;" text="P2: General" />
                </HBox>
            </HBox>
            <VBox style="-fx-padding: 0 0 4 0;" />

            <!-- Priority Residents Table — incident-table style -->
            <TableView fx:id="tblPriorityResidents" style="-fx-background-color: #161b22; -fx-border-color: transparent; -fx-table-cell-border-color: #21262d; -fx-font-size: 11px;" styleClass="incident-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colResidentName" prefWidth="105" text="Name">
                        <cellValueFactory><PropertyValueFactory property="residentName" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colVulnerability" prefWidth="80" text="Type">
                        <cellValueFactory><PropertyValueFactory property="vulnerabilityType" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colDistance" prefWidth="65" text="Dist (m)">
                        <cellValueFactory><PropertyValueFactory property="distanceFromIncident" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colRescueStatus" prefWidth="65" text="Status">
                        <cellValueFactory><PropertyValueFactory property="rescueStatus" /></cellValueFactory>
                    </TableColumn>
                </columns>
                <placeholder>
                    <Label style="-fx-text-fill: #4b5563; -fx-font-size: 11px;" text="No affected residents loaded." />
                </placeholder>
            </TableView>

            <!-- Missing Residents Header — danger-tinted panel header -->
            <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 9 14 9 14; -fx-background-color: #2d1b1b; -fx-border-color: #7f1d1d; -fx-border-width: 1 0 1 0;">
                <Label style="-fx-text-fill: #fca5a5; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 0;" styleClass="panel-title" text="MISSING RESIDENTS" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblMissingCount" style="-fx-text-fill: #fca5a5; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-color: #7f1d1d; -fx-background-radius: 10; -fx-padding: 2 8 2 8;" text="0" />
            </HBox>

            <!-- Missing Residents Table -->
            <TableView fx:id="tblMissingResidents" prefHeight="185" style="-fx-background-color: #1a0e0e; -fx-border-color: transparent; -fx-table-cell-border-color: #2d1b1b; -fx-font-size: 11px;" styleClass="incident-table">
                <columns>
                    <TableColumn fx:id="colMissingName" prefWidth="100" text="Name">
                        <cellValueFactory><PropertyValueFactory property="residentName" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colMissingContact" prefWidth="100" text="Contact">
                        <cellValueFactory><PropertyValueFactory property="contactNumber" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colLastKnownLocation" prefWidth="115" text="Last Location">
                        <cellValueFactory><PropertyValueFactory property="lastKnownLocation" /></cellValueFactory>
                    </TableColumn>
                </columns>
                <placeholder>
                    <Label style="-fx-text-fill: #4b5563; -fx-font-size: 11px;" text="No missing residents reported." />
                </placeholder>
            </TableView>

        </VBox>
    </left>

    <!-- ============================================================ -->
    <!-- CENTER: LIVE MAP PANEL                                        -->
    <!-- ============================================================ -->
    <center>
        <StackPane style="-fx-background-color: #0d1117;">

            <!-- Map WebView fills entire center -->
            <AnchorPane style="-fx-background-color: #0d1117;">
                <WebView fx:id="mapWebView" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0" />
            </AnchorPane>

            <!-- Floating Map Header Overlay — top-bar style -->
            <VBox alignment="TOP_LEFT" pickOnBounds="false">
                <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 8 12 8 12; -fx-background-color: rgba(22,27,34,0.92); -fx-border-color: #21262d; -fx-border-width: 0 0 1 0;">
                    <Label style="-fx-text-fill: #f9fafb; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 0;" styleClass="panel-title" text="LIVE INCIDENT MAP" />
                    <Label style="-fx-text-fill: #00ff88; -fx-font-size: 9px;" text="●" />
                    <Label style="-fx-text-fill: #00ff88; -fx-font-size: 10px; -fx-font-weight: bold;                                   -fx-background-color: rgba(0,255,136,0.12); -fx-background-radius: 10; -fx-padding: 2 8 2 8;" text="REAL-TIME" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblMapCoords" style="-fx-text-fill: #6b7280; -fx-font-size: 10px; -fx-font-family: 'Courier New';" text="Lat: — | Lng: —" />
                </HBox>
            </VBox>

        </StackPane>
    </center>

    <!-- ============================================================ -->
    <!-- RIGHT: EVACUATION + RESCUE TEAMS + RESOURCES PANEL           -->
    <!-- ============================================================ -->
    <right>
        <VBox prefWidth="325" spacing="0" style="-fx-background-color: #161b22; -fx-border-color: #21262d; -fx-border-width: 0 0 0 1;">

            <!-- SECTION 1: Evacuation Centers — panel-card header style -->
            <VBox VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 10 14 10 14; -fx-background-color: #1f2937; -fx-border-color: #21262d; -fx-border-width: 0 0 1 0;">
                    <Label style="-fx-text-fill: #f9fafb; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 0;" styleClass="panel-title" text="EVACUATION CENTERS" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblEvacCenterCount" style="-fx-text-fill: #34d399; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-color: #064e3b; -fx-background-radius: 10; -fx-padding: 2 8 2 8;" text="0" />
                </HBox>

                <TableView fx:id="tblEvacuationCenters" style="-fx-background-color: #161b22; -fx-border-color: transparent; -fx-table-cell-border-color: #21262d; -fx-font-size: 10px;" styleClass="incident-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colEvacName" prefWidth="100" text="Center">
                            <cellValueFactory><PropertyValueFactory property="centerName" /></cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colEvacCapacity" prefWidth="40" text="Cap">
                            <cellValueFactory><PropertyValueFactory property="capacity" /></cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colEvacOccupancy" prefWidth="40" text="Occ">
                            <cellValueFactory><PropertyValueFactory property="occupancy" /></cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colEvacDistance" prefWidth="52" text="Dist">
                            <cellValueFactory><PropertyValueFactory property="distance" /></cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colEvacStatus" prefWidth="93" text="Status">
                            <cellValueFactory><PropertyValueFactory property="status" /></cellValueFactory>
                        </TableColumn>
                    </columns>
                    <placeholder>
                        <Label style="-fx-text-fill: #4b5563; -fx-font-size: 11px;" text="No centers available." />
                    </placeholder>
                </TableView>
            </VBox>

            <!-- SECTION 2: Rescue Teams -->
            <VBox VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 10 14 10 14; -fx-background-color: #1f2937; -fx-border-color: #21262d; -fx-border-width: 1 0 1 0;">
                    <Label style="-fx-text-fill: #f9fafb; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 0;" styleClass="panel-title" text="RESCUE TEAMS" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblTeamCount" style="-fx-text-fill: #60a5fa; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-color: #1e3a5f; -fx-background-radius: 10; -fx-padding: 2 8 2 8;" text="0" />
                </HBox>

                <TableView fx:id="tblRescueTeams" style="-fx-background-color: #161b22; -fx-border-color: transparent; -fx-table-cell-border-color: #21262d; -fx-font-size: 10px;" styleClass="incident-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colTeamName" prefWidth="95" text="Team">
                            <cellValueFactory><PropertyValueFactory property="teamName" /></cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colTeamAvailability" prefWidth="72" text="Status">
                            <cellValueFactory><PropertyValueFactory property="availability" /></cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colTeamVehicle" prefWidth="78" text="Vehicle">
                            <cellValueFactory><PropertyValueFactory property="vehicle" /></cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colTeamETA" prefWidth="80" text="ETA">
                            <cellValueFactory><PropertyValueFactory property="eta" /></cellValueFactory>
                        </TableColumn>
                    </columns>
                    <placeholder>
                        <Label style="-fx-text-fill: #4b5563; -fx-font-size: 11px;" text="No rescue teams available." />
                    </placeholder>
                </TableView>
            </VBox>

            <!-- SECTION 3: Resources — with progress bars like dashboard's Resource Status -->
            <VBox VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 10 14 10 14; -fx-background-color: #1f2937; -fx-border-color: #21262d; -fx-border-width: 1 0 0 0;">
                    <Label style="-fx-text-fill: #f9fafb; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 0;" styleClass="panel-title" text="RESOURCES" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblResourceCount" style="-fx-text-fill: #a78bfa; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-color: #2e1065; -fx-background-radius: 10; -fx-padding: 2 8 2 8;" text="0" />
                </HBox>

                <!-- Quick Resource Progress Summary — mirrors dashboard's Resource Status -->
                <VBox spacing="6" style="-fx-padding: 10 14 8 14; -fx-background-color: #161b22; -fx-border-color: #21262d; -fx-border-width: 0 0 1 0;">
                    <HBox alignment="CENTER_LEFT">
                        <Label style="-fx-text-fill: #9ca3af; -fx-font-size: 10px;" styleClass="resource-label" text="Relief Goods" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblReliefPct" style="-fx-text-fill: #6b7280; -fx-font-size: 10px;" styleClass="resource-pct" text="—" />
                    </HBox>
                    <ProgressBar fx:id="pbRelief" maxWidth="Infinity" progress="0.0" style="-fx-pref-height: 5; -fx-background-radius: 3;" styleClass="progress-green" />
                    <HBox alignment="CENTER_LEFT">
                        <Label style="-fx-text-fill: #9ca3af; -fx-font-size: 10px;" styleClass="resource-label" text="Med Supplies" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblMedPct" style="-fx-text-fill: #6b7280; -fx-font-size: 10px;" styleClass="resource-pct" text="—" />
                    </HBox>
                    <ProgressBar fx:id="pbMed" maxWidth="Infinity" progress="0.0" style="-fx-pref-height: 5; -fx-background-radius: 3;" styleClass="progress-amber" />
                    <HBox alignment="CENTER_LEFT">
                        <Label style="-fx-text-fill: #9ca3af; -fx-font-size: 10px;" styleClass="resource-label" text="Evac Center Cap." />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblEvacCapPct" style="-fx-text-fill: #6b7280; -fx-font-size: 10px;" styleClass="resource-pct" text="—" />
                    </HBox>
                    <ProgressBar fx:id="pbEvacCap" maxWidth="Infinity" progress="0.0" style="-fx-pref-height: 5; -fx-background-radius: 3;" styleClass="progress-blue" />
                </VBox>

                <TableView fx:id="tblResources" style="-fx-background-color: #161b22; -fx-border-color: transparent; -fx-table-cell-border-color: #21262d; -fx-font-size: 10px;" styleClass="incident-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colResourceType" prefWidth="140" text="Resource">
                            <cellValueFactory><PropertyValueFactory property="resourceType" /></cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colResourceQuantity" prefWidth="55" text="Qty">
                            <cellValueFactory><PropertyValueFactory property="quantity" /></cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colResourceStatus" prefWidth="130" text="Status">
                            <cellValueFactory><PropertyValueFactory property="status" /></cellValueFactory>
                        </TableColumn>
                    </columns>
                    <placeholder>
                        <Label style="-fx-text-fill: #4b5563; -fx-font-size: 11px;" text="No resources loaded." />
                    </placeholder>
                </TableView>
            </VBox>

        </VBox>
    </right>

    <!-- ============================================================ -->
    <!-- BOTTOM: LOGS + ANALYTICS + STAT CARDS PANEL                  -->
    <!-- ============================================================ -->
    <bottom>
        <HBox prefHeight="225" style="-fx-background-color: #161b22; -fx-border-color: #21262d; -fx-border-width: 1 0 0 0;">

            <!-- LEFT: Incident Logs -->
            <VBox prefWidth="430" style="-fx-border-color: #21262d; -fx-border-width: 0 1 0 0;">
                <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 8 14 8 14; -fx-background-color: #1f2937; -fx-border-color: #21262d; -fx-border-width: 0 0 1 0;">
                    <Label style="-fx-text-fill: #f9fafb; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 0;" styleClass="panel-title" text="INCIDENT LOGS" />
                </HBox>

                <ListView fx:id="listIncidentLogs" style="-fx-background-color: #0d1117; -fx-border-color: transparent; -fx-font-family: 'Courier New'; -fx-font-size: 10px;" VBox.vgrow="ALWAYS">
                    <placeholder>
                        <Label style="-fx-text-fill: #4b5563; -fx-font-size: 11px;" text="No logs recorded." />
                    </placeholder>
                </ListView>
            </VBox>

            <!-- RIGHT: Analytics Charts + Stat Summary Cards -->
            <VBox HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 8 14 8 14; -fx-background-color: #1f2937; -fx-border-color: #21262d; -fx-border-width: 0 0 1 0;">
                    <Label style="-fx-text-fill: #f9fafb; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 0;" styleClass="panel-title" text="ANALYTICS OVERVIEW" />
                </HBox>

                <HBox spacing="0" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">

                    <!-- Bar Chart -->
                    <BarChart fx:id="chartAnalytics" animated="false" legendVisible="false" style="-fx-background-color: transparent; -fx-font-size: 10px;" styleClass="analytical-bar-chart" HBox.hgrow="ALWAYS">
                        <xAxis>
                            <CategoryAxis fx:id="chartXAxis" style="-fx-tick-label-fill: #6b7280; -fx-tick-label-font-size: 10px;" styleClass="chart-axis" />
                        </xAxis>
                        <yAxis>
                            <NumberAxis fx:id="chartYAxis" style="-fx-tick-label-fill: #6b7280; -fx-tick-label-font-size: 10px;" styleClass="chart-axis" />
                        </yAxis>
                    </BarChart>

                    <!-- Stat Summary Cards — mirrors dashboard KPI cards in dark variant -->
                    <HBox alignment="CENTER" spacing="10" style="-fx-padding: 14 16 14 8;">

                        <!-- Total Affected -->
                        <VBox alignment="CENTER" minWidth="110" style="-fx-background-color: #1f2937; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #21262d; -fx-border-width: 1; -fx-padding: 10 16 10 16;" styleClass="kpi-card">
                            <Label style="-fx-text-fill: #6b7280; -fx-font-size: 8px; -fx-font-weight: bold;" styleClass="kpi-label" text="TOTAL AFFECTED" />
                            <Label fx:id="lblTotalAffected" style="-fx-text-fill: #f9fafb; -fx-font-size: 26px; -fx-font-weight: bold;" styleClass="kpi-value" text="—" />
                        </VBox>

                        <!-- Rescued — kpi-success style -->
                        <VBox alignment="CENTER" minWidth="110" style="-fx-background-color: #1f2937; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: rgba(29,158,117,0.25); -fx-border-width: 1; -fx-padding: 10 16 10 16;" styleClass="kpi-card, kpi-success">
                            <Label style="-fx-text-fill: #6b7280; -fx-font-size: 8px; -fx-font-weight: bold;" styleClass="kpi-label" text="RESCUED" />
                            <Label fx:id="lblRescued" style="-fx-text-fill: #34d399; -fx-font-size: 26px; -fx-font-weight: bold;" styleClass="kpi-value" text="—" />
                        </VBox>

                        <!-- Missing — kpi-danger style -->
                        <VBox alignment="CENTER" minWidth="110" style="-fx-background-color: #1f2937; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: rgba(192,57,43,0.25); -fx-border-width: 1; -fx-padding: 10 16 10 16;" styleClass="kpi-card, kpi-danger">
                            <Label style="-fx-text-fill: #6b7280; -fx-font-size: 8px; -fx-font-weight: bold;" styleClass="kpi-label" text="MISSING" />
                            <Label fx:id="lblMissing" style="-fx-text-fill: #fca5a5; -fx-font-size: 26px; -fx-font-weight: bold;" styleClass="kpi-value" text="—" />
                        </VBox>

                        <!-- Evacuated — kpi-info style -->
                        <VBox alignment="CENTER" minWidth="110" style="-fx-background-color: #1f2937; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: rgba(52,152,219,0.25); -fx-border-width: 1; -fx-padding: 10 16 10 16;" styleClass="kpi-card, kpi-info">
                            <Label style="-fx-text-fill: #6b7280; -fx-font-size: 8px; -fx-font-weight: bold;" styleClass="kpi-label" text="EVACUATED" />
                            <Label fx:id="lblEvacuated" style="-fx-text-fill: #60a5fa; -fx-font-size: 26px; -fx-font-weight: bold;" styleClass="kpi-value" text="—" />
                        </VBox>

                    </HBox>
                </HBox>
            </VBox>

        </HBox>
    </bottom>

</BorderPane>
