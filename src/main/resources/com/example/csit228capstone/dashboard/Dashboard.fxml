<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane prefHeight="1000.0" prefWidth="1200.0" fx:id="mainContent" fitToWidth="true" styleClass="dashboard-scroll" stylesheets="@../../../../css/application.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.csit228capstone.controller.dashboard.DashboardController">

    <VBox alignment="TOP_CENTER" spacing="24">
        <padding><Insets topRightBottomLeft="16" /></padding>

        <!-- ── KPI Cards Row ─────────────────────────────────────────────────── -->
        <HBox fx:id="kpiRow" spacing="16">
            <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                <Label styleClass="kpi-label" text="Total Residents" />
                <Label fx:id="lblTotalResidents" styleClass="kpi-value" text="0" />
                <Label styleClass="kpi-sub" text="Registered in system" />
            </VBox>
            <VBox styleClass="kpi-card, kpi-danger" HBox.hgrow="ALWAYS">
                <Label styleClass="kpi-label" text="Active Incidents" />
                <Label fx:id="lblActiveIncidents" styleClass="kpi-value" text="0" />
                <Label styleClass="kpi-sub" text="Require attention" />
            </VBox>
            <VBox styleClass="kpi-card, kpi-info" HBox.hgrow="ALWAYS">
                <Label styleClass="kpi-label" text="Evacuees" />
                <Label fx:id="lblEvacuees" styleClass="kpi-value" text="0" />
                <Label styleClass="kpi-sub" text="Currently sheltered" />
            </VBox>
        </HBox>

        <!-- ── Middle Row: Incident Monitor + Quick Actions ─────────────────── -->
        <HBox spacing="16">

            <!-- Live Incident Monitor -->
            <VBox styleClass="panel-card" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label styleClass="panel-title" text="Live Incident Monitor" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Hyperlink onAction="#viewAllIncidents" styleClass="panel-link" text="View all →" />
                </HBox>
                <TableView fx:id="incidentTable" prefHeight="250" styleClass="incident-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colSeverity" prefWidth="30" text="" />
                        <TableColumn fx:id="colType" prefWidth="140" text="Incident" />
                        <TableColumn fx:id="colLocation" prefWidth="130" text="Location" />
                        <TableColumn fx:id="colTime" prefWidth="80" text="Time" />
                        <TableColumn fx:id="colStatus" prefWidth="100" text="Status" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>

            <!-- Quick Actions -->
            <VBox prefWidth="200" spacing="12" styleClass="panel-card">
                <Label styleClass="panel-title" text="Quick Actions" />
                <Button maxWidth="Infinity" onAction="#reportIncident" styleClass="quick-action-btn, qa-danger" text="Report Incident" />
                <Button maxWidth="Infinity" onAction="#evacuationCenter" styleClass="quick-action-btn, qa-warning" text="Evacuation Center" />
                <Button maxWidth="Infinity" onAction="#addResident" styleClass="quick-action-btn" text="Add Resident" />
            </VBox>
        </HBox>

        <!-- ── Bottom Row: Resources + Vulnerable + Weather ─────────────────── -->
        <HBox spacing="16">

            <!-- Resource Status — driven by ResourceRepository -->
            <VBox spacing="12" styleClass="panel-card" HBox.hgrow="ALWAYS">
                <Label styleClass="panel-title" text="Resource Status" />
                <VBox spacing="8">
                    <!-- Relief Goods -->
                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="resource-label" text="Relief Goods" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblRelief" styleClass="resource-pct" text="–%" />
                    </HBox>
                    <ProgressBar fx:id="pbRelief" maxWidth="Infinity" progress="0" styleClass="progress-green" />

                    <!-- Medical -->
                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="resource-label" text="Medical" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblMed" styleClass="resource-pct" text="–%" />
                    </HBox>
                    <ProgressBar fx:id="pbMed" maxWidth="Infinity" progress="0" styleClass="progress-amber" />

                    <!-- Emergency Fund -->
                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="resource-label" text="Emergency Fund" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblFund" styleClass="resource-pct" text="–%" />
                    </HBox>
                    <ProgressBar fx:id="pbFund" maxWidth="Infinity" progress="0" styleClass="progress-red" />

                </VBox>
            </VBox>

            <!-- Vulnerable Residents -->
            <VBox spacing="12" styleClass="panel-card" HBox.hgrow="ALWAYS">
                <Label styleClass="panel-title" text="Vulnerable Residents" />
                <HBox alignment="CENTER_LEFT" spacing="90.0">
                    <VBox alignment="CENTER_LEFT" prefHeight="52.0" prefWidth="72.0">
                        <Label fx:id="lblSenior" styleClass="vuln-count" text="–" textFill="#bf5d5d" />
                        <Label styleClass="vuln-label" text="Senior Citizens" />
                    </VBox>
                    <VBox alignment="CENTER_LEFT" prefHeight="52.0" prefWidth="44.0" spacing="4">
                        <Label fx:id="lblPwd" styleClass="vuln-count" text="–">
                     <VBox.margin>
                        <Insets />
                     </VBox.margin></Label>
                        <Label styleClass="vuln-label" text="PWD" />
                  <HBox.margin>
                     <Insets left="-23.0" />
                  </HBox.margin>
                    </VBox>
                    <VBox alignment="CENTER_LEFT" spacing="4">
                        <Label fx:id="lblIndigenous" styleClass="vuln-count" text="–" />
                        <Label styleClass="vuln-label" text="Indigenous" />
                    </VBox>
                    <VBox.margin><Insets /></VBox.margin>
                    <padding><Insets left="15.0" /></padding>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="73.0">
                    <VBox alignment="CENTER_LEFT" prefWidth="66.0" spacing="4">
                        <Label fx:id="lblPregnant" styleClass="vuln-count" text="–" />
                        <Label styleClass="vuln-label" text="Pregnant" />
                    </VBox>
                    <VBox alignment="CENTER_LEFT" spacing="4">
                        <Label fx:id="lblChildren" styleClass="vuln-count" text="–" />
                        <Label styleClass="vuln-label" text="Children (0-5)" />
                    </VBox>
                    <VBox alignment="CENTER_LEFT" spacing="4">
                        <Label fx:id="lblSoloParent" styleClass="vuln-count" text="–" />
                        <Label styleClass="vuln-label" text="Solo Parent" />
                    </VBox>
                    <padding><Insets left="15.0" top="15.0" /></padding>
                </HBox>
            </VBox>

            <!-- Weather Widget — populated by OpenWeatherMap API -->
            <VBox prefWidth="220" spacing="4" styleClass="panel-card, weather-card">
                <Label fx:id="lblWeatherTemp" styleClass="weather-temp" text="--°C" />
                <HBox spacing="16">
                    <VBox>
                        <Label fx:id="lblHumidity" styleClass="weather-stat" text="--%" />
                        <Label styleClass="weather-stat-label" text="Humidity" />
                    </VBox>
                    <VBox>
                        <Label fx:id="lblWind" styleClass="weather-stat" text="-- kph" />
                        <Label styleClass="weather-stat-label" text="Wind" />
                    </VBox>
                </HBox>
                <Label fx:id="lblWeatherDesc" styleClass="weather-desc" text="Loading… · Bacolod City" />
            </VBox>

        </HBox>
    </VBox>
</ScrollPane>
