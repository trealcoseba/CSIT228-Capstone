<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="0" prefHeight="780.0" prefWidth="840.0"
      stylesheets="@../../../../css/application.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.csit228capstone.controller.reports.ReportPreviewController">

    <HBox alignment="CENTER_LEFT" spacing="10"
          style="-fx-background-color:#F0F9F5;
                 -fx-border-color:#1D9E75;
                 -fx-border-width:0 0 1 0;
                 -fx-padding:10 18;">
        <Label text="Report Preview"
               style="-fx-font-size:15;-fx-font-weight:bold;-fx-text-fill:#1A2E44;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnPdf" text="⬇  Export PDF"
                styleClass="quick-action-btn, qa-danger"
                onAction="#handleExportPdf" prefWidth="140"/>
        <Button fx:id="btnWord" text="⬇  Export Word"
                styleClass="quick-action-btn, qa-navy"
                onAction="#handleExportWord" prefWidth="140"/>
        <Button fx:id="btnClose" text="✕  Close"
                onAction="#handleClose" prefWidth="90"
                style="-fx-background-color:#E5E7EB;-fx-text-fill:#374151;
                       -fx-background-radius:8;-fx-padding:10 16;-fx-cursor:hand;
                       -fx-font-weight:600;"/>
    </HBox>

    <ScrollPane fx:id="scrollPreview" fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color:#D1D5DB;-fx-background:transparent;">
        <content>
            <HBox alignment="TOP_CENTER" style="-fx-padding:28 0 28 0;">
                <VBox fx:id="vboxDocument" spacing="6" prefWidth="700"
                      style="-fx-background-color:white;
                             -fx-padding:44 52 44 52;
                             -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.13),14,0,0,3);
                             -fx-background-radius:3;">
                </VBox>
            </HBox>
        </content>
    </ScrollPane>

</VBox>
