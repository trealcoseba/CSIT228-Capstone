<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="15.0" style="-fx-background-color: white;" stylesheets="@../../../../css/application.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.csit228capstone.controller.map.MapPickerController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <VBox spacing="5">
        <Label style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Select Resident Location" />
        <Label style="-fx-text-fill: gray; -fx-font-size: 12;" text="Click on the map to pin the exact household location." />
    </VBox>

    <!-- The Map View -->
    <WebView fx:id="webView" VBox.vgrow="ALWAYS" style="-fx-border-color: #ddd; -fx-border-width: 1;"/>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <TextField fx:id="txtSelectedAddress" editable="true" promptText="Address will appear here after pinning..." HBox.hgrow="ALWAYS" />
        <Button onAction="#handleConfirm" prefWidth="120.0" styleClass="quick-action-btn" text="Confirm Pin" />
        <Button onAction="#handleCancel" prefWidth="100.0" styleClass="quick-action-btn, qa-danger" text="Cancel" />
    </HBox>
</VBox>