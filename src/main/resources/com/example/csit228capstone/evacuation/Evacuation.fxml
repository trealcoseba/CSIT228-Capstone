<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<ScrollPane fitToWidth="true" prefHeight="800.0" prefWidth="1000.0" styleClass="dashboard-scroll" stylesheets="@../../../../css/application.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.csit228capstone.controller.evacuation.EvacuationController">

    <content>
        <VBox fillWidth="true" spacing="16">
            <padding>
                <Insets topRightBottomLeft="16" />
            </padding>

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <children>
                    <Label styleClass="page-title" text="Evacuation Management" />
                    <Region HBox.hgrow="ALWAYS" />
                </children>
            </HBox>

            <!-- Status Card -->
            <VBox spacing="12" styleClass="panel-card">
                <children>
                    <Label styleClass="panel-title" text="Evacuation Status" />
                    <HBox alignment="CENTER_LEFT" spacing="16">
                        <children>
                            <VBox prefHeight="56.0" prefWidth="50.0" HBox.hgrow="ALWAYS">
                                <children>
                                    <Label styleClass="resource-label" text="Total Evacuees:" />
                                    <Label fx:id="lblTotalEvacuees" styleClass="kpi-value" text="0" />
                                </children>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS">
                                <children>
                                    <Label styleClass="resource-label" text="Centers Active:" />
                                    <Label fx:id="lblCentersActive" styleClass="kpi-value" text="0" />
                                </children>
                            </VBox>
                        </children>
                    </HBox>
                </children>
            </VBox>

            <!-- Main Row (Map and Sidebar) -->
            <HBox spacing="16" VBox.vgrow="ALWAYS">
                <VBox spacing="12" styleClass="panel-card" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                    <children>
                        <Label styleClass="panel-title" text="Evacuation Map" />
                        <StackPane maxHeight="500" minHeight="500" prefHeight="500" VBox.vgrow="ALWAYS">
                            <WebView fx:id="mapWebView" maxHeight="498.0" maxWidth="545.0" minHeight="400" minWidth="400" prefHeight="498.0" prefWidth="505.0" StackPane.alignment="CENTER" />
                        </StackPane>
                    </children>
                </VBox>

                <VBox prefWidth="350" spacing="12" styleClass="panel-card">
                    <children>
                        <Label styleClass="panel-title" text="Evacuation Centers" />
                        <ListView fx:id="centersList" prefHeight="250" VBox.vgrow="ALWAYS" />
                        <Button maxWidth="Infinity" onAction="#addCenter" styleClass="quick-action-btn" text="Add Center" />
                    </children>
                </VBox>
            </HBox>

            <!-- Filters -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <ComboBox fx:id="filterStatus" prefWidth="120" promptText="Status" />
                <ComboBox fx:id="filterAscOrDesc" prefWidth="120" />
                <Region HBox.hgrow="ALWAYS" />

                <Button onAction="#handleRefresh" styleClass="quick-action-btn" text="Reset Filters" />

                <TextField fx:id="tfSearch" prefWidth="200" promptText="🔍 Search residents..." styleClass="search-field" />
                <padding>
                    <Insets top="30.0" />
                </padding>
            </HBox>

            <!-- Table Section -->
            <VBox spacing="12" styleClass="panel-card" VBox.vgrow="ALWAYS">
                <children>
                    <Label styleClass="panel-title" text="Evacuation Centers Details" />

                    <!-- 1. Removed CONSTRAINED_RESIZE_POLICY to allow horizontal scroll -->
                    <TableView fx:id="centersTable" prefHeight="350" styleClass="incident-table" VBox.vgrow="ALWAYS">
                        <columns>
                            <!-- 2. Set minWidth to ensure the total width exceeds the container for scrolling -->
                            <TableColumn fx:id="colName" minWidth="180" text="Center Name" />
                            <TableColumn fx:id="colAddress" minWidth="250" text="Center Address" />
                            <TableColumn fx:id="colCapacity" minWidth="100" text="Capacity" />
                            <TableColumn fx:id="colOccupancy" minWidth="120" text="Current Count" />
                            <TableColumn fx:id="colStatus" minWidth="120" text="Status" />
                            <TableColumn fx:id="colManager" minWidth="150" text="Manager" />
                            <TableColumn fx:id="colContact" minWidth="150" text="Contact" />
                            <TableColumn fx:id="colActions" minWidth="150" text="Actions" />
                        </columns>
                        <!-- Default policy is unconstrained, which enables scrolling -->
                    </TableView>
                </children>
            </VBox>
        </VBox>
    </content>
</ScrollPane>