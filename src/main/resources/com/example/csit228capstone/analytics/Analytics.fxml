<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane prefHeight="1000.0" prefWidth="1200.0" styleClass="dashboard-scroll" stylesheets="@../../../../css/application.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.csit228capstone.controller.analytics.AnalyticsController">

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;" vbarPolicy="AS_NEEDED">
            <VBox fillWidth="true" spacing="16">
                <padding>
                    <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label styleClass="page-title" text="System Analytics" />
                    <Region HBox.hgrow="ALWAYS" />
                </HBox>

                <HBox spacing="16">
                    <padding><Insets top="12.0" /></padding>

                    <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                        <Label styleClass="kpi-label" text="Incident Growth" />
                        <Label fx:id="lblGrowthRate" styleClass="kpi-value" text="+0%" />
                        <HBox alignment="CENTER_LEFT" spacing="5">
                            <Label styleClass="kpi-sub" text="vs. last month:" />
                            <Label fx:id="lblPrevMonthCount" style="-fx-font-weight:bold;" styleClass="kpi-sub" text="0" />
                        </HBox>
                    </VBox>

                    <Region prefHeight="110.0" prefWidth="50.0" />

                    <VBox styleClass="kpi-card kpi-info" HBox.hgrow="ALWAYS">
                        <Label styleClass="kpi-label" text="Avg. Resolution Time" />
                        <Label fx:id="lblAvgResolution" styleClass="kpi-value" text="0.0h" />
                        <HBox alignment="CENTER_LEFT" spacing="5">
                            <Label styleClass="kpi-sub" text="Prev. month:" />
                            <Label fx:id="lblPrevAvgResolution" style="-fx-font-weight:bold;" styleClass="kpi-sub" text="0.0h" />
                        </HBox>
                    </VBox>

                    <VBox styleClass="kpi-card kpi-warning" HBox.hgrow="ALWAYS">
                        <Label styleClass="kpi-label" text="Shelter Utilization" />
                        <Label fx:id="lblUtilization" styleClass="kpi-value" text="0%" />
                        <HBox alignment="CENTER_LEFT" spacing="5">
                            <Label styleClass="kpi-sub" text="Peak last month:" />
                            <Label fx:id="lblPrevUtilization" style="-fx-font-weight:bold;" styleClass="kpi-sub" text="0%" />
                        </HBox>
                    </VBox>

                    <VBox styleClass="kpi-card kpi-danger" HBox.hgrow="ALWAYS">
                        <Label styleClass="kpi-label" text="Vulnerability Ratio" />
                        <Label fx:id="lblVulnerabilityRatio" styleClass="kpi-value" text="0%" />
                        <HBox alignment="CENTER_LEFT" spacing="5">
                            <Label styleClass="kpi-sub" text="Last month:" />
                            <Label fx:id="lblPrevVulnerability" style="-fx-font-weight:bold;" styleClass="kpi-sub" text="0%" />
                        </HBox>
                    </VBox>
                </HBox>

                <VBox spacing="20" styleClass="panel-card">
                    <Label styleClass="panel-title" text="Data Visualizations" />

                    <HBox alignment="CENTER" spacing="16">

                        <VBox spacing="0" styleClass="chart-container" HBox.hgrow="ALWAYS">

                            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="chart-header-band">
                                <VBox spacing="2" HBox.hgrow="ALWAYS">
                                    <Label styleClass="chart-title" text="Incident Frequency by Disaster Category" />
                                    <Label styleClass="chart-subtitle" text="Total reported incidents grouped by disaster type" />
                                </VBox>
                                <HBox alignment="CENTER" spacing="4" styleClass="chart-legend-inline">
                                    <Rectangle arcHeight="4" arcWidth="4" fill="#4f8ef7" height="10" width="10" />
                                    <Label styleClass="chart-legend-label" text="Incidents" />
                                </HBox>
                            </HBox>

                            <Separator styleClass="chart-divider" />

                            <StackPane styleClass="chart-body-wrap">
                                <ScrollPane fitToHeight="true" fitToWidth="false" hbarPolicy="AS_NEEDED" minHeight="300" styleClass="chart-scroll" vbarPolicy="NEVER">
                                    <BarChart fx:id="chartIncidentFrequency" animated="false" barGap="3" categoryGap="16" legendVisible="false" prefHeight="300" prefWidth="520" styleClass="analytical-bar-chart">
                                        <xAxis>
                                            <CategoryAxis fx:id="axisIncidentX" label="Disaster Category" styleClass="chart-axis" />
                                        </xAxis>
                                        <yAxis>
                                            <NumberAxis fx:id="axisIncidentY" autoRanging="false" label="No. of Incidents" lowerBound="0" minorTickVisible="false" styleClass="chart-axis" tickUnit="25" upperBound="150" />
                                        </yAxis>
                                    </BarChart>
                                </ScrollPane>
                            </StackPane>

                            <HBox alignment="CENTER_RIGHT" styleClass="chart-footer">
                                <Label styleClass="chart-footnote" text="*Data reflects current reporting period" />
                            </HBox>
                        </VBox>

                        <VBox spacing="0" styleClass="chart-container" HBox.hgrow="ALWAYS">

                            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="chart-header-band">
                                <VBox spacing="2" HBox.hgrow="ALWAYS">
                                    <Label styleClass="chart-title" text="Avg. Response Time by Disaster Category" />
                                    <Label styleClass="chart-subtitle" text="Mean hours from report to resolution" />
                                </VBox>
                                <HBox alignment="CENTER" spacing="4" styleClass="chart-legend-inline">
                                    <Rectangle arcHeight="4" arcWidth="4" fill="#f7924f" height="10" width="10" />
                                    <Label styleClass="chart-legend-label" text="Hours" />
                                </HBox>
                            </HBox>

                            <Separator styleClass="chart-divider" />

                            <StackPane styleClass="chart-body-wrap">
                                <ScrollPane fitToHeight="true" fitToWidth="false" hbarPolicy="AS_NEEDED" minHeight="300" styleClass="chart-scroll" vbarPolicy="NEVER">
                                    <BarChart fx:id="chartAvgResolution" animated="false" barGap="3" categoryGap="16" legendVisible="false" prefHeight="300" prefWidth="520" styleClass="analytical-bar-chart analytical-bar-chart-orange">
                                        <xAxis>
                                            <CategoryAxis fx:id="axisResolutionX" label="Disaster Category" styleClass="chart-axis" />
                                        </xAxis>
                                        <yAxis>
                                            <NumberAxis fx:id="axisResolutionY" autoRanging="false" label="Hours" lowerBound="0" minorTickVisible="false" styleClass="chart-axis" tickUnit="25" upperBound="150" />
                                        </yAxis>
                                    </BarChart>
                                </ScrollPane>
                            </StackPane>

                            <HBox alignment="CENTER_RIGHT" styleClass="chart-footer">
                                <Label styleClass="chart-footnote" text="*Lower values indicate faster response" />
                            </HBox>
                        </VBox>
                    </HBox>

                    <HBox spacing="16">

                        <VBox prefHeight="380.0" prefWidth="473.0" spacing="0" styleClass="chart-container" HBox.hgrow="ALWAYS">

                            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="chart-header-band">
                                <VBox spacing="2" HBox.hgrow="ALWAYS">
                                    <Label styleClass="chart-title" text="Resource Usage by Evacuation Center" />
                                    <Label styleClass="chart-subtitle" text="Stacked quantities of supplies distributed per center" />
                                </VBox>
                            </HBox>

                            <Separator styleClass="chart-divider" />

                            <StackPane styleClass="chart-body-wrap" VBox.vgrow="ALWAYS">
                                <ScrollPane fitToHeight="true" fitToWidth="false" hbarPolicy="AS_NEEDED" minHeight="280" styleClass="chart-scroll" vbarPolicy="NEVER">
                                    <StackedBarChart fx:id="chartResourceUsage" animated="false" categoryGap="16" prefHeight="280" prefWidth="520" styleClass="analytical-bar-chart analytical-stacked-chart">
                                        <xAxis>
                                            <CategoryAxis fx:id="axisResourceX" label="Evacuation Center" styleClass="chart-axis" />
                                        </xAxis>
                                        <yAxis>
                                            <NumberAxis fx:id="axisResourceY" autoRanging="false" label="Quantity" lowerBound="0" minorTickVisible="false" styleClass="chart-axis" tickUnit="25" upperBound="150" />
                                        </yAxis>
                                    </StackedBarChart>
                                </ScrollPane>
                            </StackPane>

                            <HBox alignment="CENTER_RIGHT" styleClass="chart-footer">
                                <Label styleClass="chart-footnote" text="*Each colour segment represents a resource type" />
                            </HBox>
                        </VBox>

                        <VBox spacing="0" styleClass="chart-container" HBox.hgrow="ALWAYS">

                            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="chart-header-band">
                                <VBox spacing="2" HBox.hgrow="ALWAYS">
                                    <Label styleClass="chart-title" text="Demographic Breakdown" />
                                    <Label styleClass="chart-subtitle" text="High-priority resident segments" />
                                </VBox>
                            </HBox>

                            <Separator styleClass="chart-divider" />

                            <StackPane styleClass="chart-body-wrap" VBox.vgrow="ALWAYS">
                                <ScrollPane fitToHeight="false" fitToWidth="false" hbarPolicy="AS_NEEDED" minHeight="280" styleClass="chart-scroll" vbarPolicy="AS_NEEDED">
                                    <PieChart fx:id="chartDemographic" animated="false" clockwise="true" labelsVisible="true" legendSide="BOTTOM" prefHeight="280" prefWidth="440" startAngle="90" styleClass="analytical-pie-chart" />
                                </ScrollPane>
                            </StackPane>

                            <HBox alignment="CENTER_RIGHT" styleClass="chart-footer">
                                <Label styleClass="chart-footnote" text="*Based on vulnerability classification data" />
                            </HBox>
                        </VBox>
                    </HBox>

                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
