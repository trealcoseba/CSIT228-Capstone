<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="1000.0" prefWidth="1200.0" styleClass="dashboard-scroll" stylesheets="@../../../../css/application.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.csit228capstone.controller.analytics.AnalyticsController">

    <center>
        <VBox fillWidth="true" spacing="16">
            <padding>
                <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
            </padding>

            <!-- Header with Title and Actions -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <children>
                    <Label styleClass="page-title" text="Analytics" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#export" prefHeight="39.0" prefWidth="137.0" styleClass="quick-action-btn" text="Export" />
                </children>
            </HBox>

            <!-- Statistics Overview -->
            <HBox spacing="16">
                <children>
                    <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                        <Label styleClass="kpi-label" text="Total Incidents" />
                        <Label fx:id="lblTotalIncidents" styleClass="kpi-value" text="0" />
                        <Label styleClass="kpi-sub" text="This month" />
                    </VBox>
                    <VBox alignment="CENTER" styleClass="kpi-card kpi-danger" HBox.hgrow="ALWAYS">
                        <Label styleClass="kpi-label" text="Critical Incidents" />
                        <Label fx:id="lblCritical" styleClass="kpi-value" text="0" />
                        <Label styleClass="kpi-sub" text="Requiring attention" />
                    </VBox>
                    <VBox alignment="CENTER" styleClass="kpi-card kpi-info" HBox.hgrow="ALWAYS">
                        <Label styleClass="kpi-label" text="Avg. Response Time" />
                        <Label fx:id="lblAvgResponse" styleClass="kpi-value" text="0 min" />
                        <HBox.margin>
                            <Insets top="-19.0" />
                        </HBox.margin>
                    </VBox>
                    <VBox alignment="CENTER" styleClass="kpi-card kpi-warning" HBox.hgrow="ALWAYS">
                        <Label styleClass="kpi-label" text="Resolution Rate" />
                        <Label fx:id="lblResolution" styleClass="kpi-value" text="0%" />
                        <HBox.margin>
                            <Insets top="-19.0" />
                        </HBox.margin>
                    </VBox>
                </children>
            </HBox>

            <!-- Charts Area Placeholder -->
            <VBox spacing="16" styleClass="panel-card" VBox.vgrow="ALWAYS">
                <children>
                    <Label styleClass="panel-title" text="Analytics &amp; Charts" />
                    <HBox alignment="CENTER" spacing="16">
                        <children>
                            <StackPane prefHeight="250" prefWidth="400.0" styleClass="panel-card" HBox.hgrow="ALWAYS">
                                <Label styleClass="page-subtitle" text="Incidents by Type Chart" textAlignment="CENTER" wrapText="true" />
                            </StackPane>
                            <StackPane prefHeight="250" prefWidth="400.0" styleClass="panel-card" HBox.hgrow="ALWAYS">
                                <Label styleClass="page-subtitle" text="Response Time Trend Chart" textAlignment="CENTER" wrapText="true" />
                            </StackPane>
                        </children>
                    </HBox>
                    <HBox spacing="16">
                        <children>
                            <StackPane prefHeight="250.0" prefWidth="400.0" styleClass="panel-card" HBox.hgrow="ALWAYS">
                                <Label styleClass="page-subtitle" text="Resource Utilization Chart" />
                            </StackPane>
                            <StackPane prefHeight="200" prefWidth="400.0" styleClass="panel-card" HBox.hgrow="ALWAYS">
                                <Label styleClass="page-subtitle" text="Vulnerable Groups Chart" />
                            </StackPane>
                        </children>
                    </HBox>
                </children>
            </VBox>
        </VBox>
    </center>
</BorderPane>