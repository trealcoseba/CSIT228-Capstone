<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefWidth="480" spacing="0"
      styleClass="root-pane"
      stylesheets="@../../../../css/application.css"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.csit228capstone.controller.responder.ResponderFormController">

    <HBox styleClass="dialog-header" alignment="CENTER_LEFT" spacing="12">
        <padding><Insets topRightBottomLeft="16" /></padding>
        <Label fx:id="lblFormTitle" styleClass="dialog-title" text="Add Responder" />
    </HBox>

    <VBox spacing="20" VBox.vgrow="ALWAYS">
        <padding><Insets top="24" right="24" bottom="8" left="24" /></padding>

        <VBox spacing="6">
            <Label styleClass="form-label" text="Full Name *" />
            <TextField fx:id="tfName"
                       promptText="e.g. Juan Dela Cruz"
                       styleClass="form-input" />
            <Label fx:id="errName" styleClass="form-error" text="" visible="false" managed="false" />
        </VBox>

        <VBox spacing="6">
            <Label styleClass="form-label" text="Agency *" />
            <ComboBox fx:id="cbAgency"
                      prefWidth="1000"
                      promptText="Select or type agency…"
                      editable="true"
                      styleClass="form-input" />
            <Label fx:id="errAgency" styleClass="form-error" text="" visible="false" managed="false" />
        </VBox>

        <VBox spacing="6">
            <Label styleClass="form-label" text="Contact Number" />
            <TextField fx:id="tfContact"
                       promptText="e.g. 09171234567"
                       styleClass="form-input" />
        </VBox>

        <VBox spacing="6">
            <Label styleClass="form-label" text="Status *" />
            <ComboBox fx:id="cbStatus"
                      prefWidth="1000"
                      styleClass="form-input" />
            <Label fx:id="errStatus" styleClass="form-error" text="" visible="false" managed="false" />
        </VBox>

    </VBox>

    <HBox alignment="CENTER_RIGHT" spacing="12">
        <padding><Insets top="16" right="24" bottom="24" left="24" /></padding>
        <Button onAction="#handleCancel"
                styleClass="btn-outline"
                text="Cancel" />
        <Button fx:id="btnSave"
                onAction="#handleSave"
                styleClass="quick-action-btn"
                text="Save Responder" />
    </HBox>

</VBox>
