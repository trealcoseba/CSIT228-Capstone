<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane prefHeight="800.0" prefWidth="1000.0" fitToWidth="true" styleClass="dashboard-scroll" stylesheets="@../../../../css/application.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.csit228capstone.controller.resources.ResourcesController">
    <VBox spacing="16">
        <padding><Insets topRightBottomLeft="16" /></padding>

        <!-- Header with Title and Actions -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label styleClass="page-title" text="Resource Management" />
            <Region HBox.hgrow="ALWAYS" />
            <TextField prefWidth="200" promptText="🔍 Search resources..." styleClass="search-field" />
            <Button onAction="#addResource" styleClass="quick-action-btn" text="➕ Add Resource" />
        </HBox>

        <!-- Resource Overview Cards -->
        <HBox spacing="16">
            <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                <Label styleClass="kpi-label" text="Relief Goods" />
                <Label fx:id="lblReliefGoods" styleClass="kpi-value" text="1,250" />
                <Label styleClass="kpi-sub" text="units in stock" />
            </VBox>
            <VBox styleClass="kpi-card, kpi-info" HBox.hgrow="ALWAYS">
                <Label styleClass="kpi-label" text="Medical Supplies" />
                <Label fx:id="lblMedicalSupplies" styleClass="kpi-value" text="320" />
                <Label styleClass="kpi-sub" text="units in stock" />
            </VBox>
            <VBox styleClass="kpi-card, kpi-warning" HBox.hgrow="ALWAYS">
                <Label styleClass="kpi-label" text="Emergency Fund" />
                <Label fx:id="lblFund" styleClass="kpi-value" text="₱245K" />
                <Label styleClass="kpi-sub" text="available" />
            </VBox>
            <VBox styleClass="kpi-card, kpi-danger" HBox.hgrow="ALWAYS">
                <Label styleClass="kpi-label" text="Low Stock Items" />
                <Label fx:id="lblLowStock" styleClass="kpi-value" text="3" />
                <Label styleClass="kpi-sub" text="need replenishment" />
            </VBox>
        </HBox>

        <!-- Filters & Controls -->
        <HBox spacing="12">
            <Label styleClass="filter-label" text="Filter:" />
            <ComboBox fx:id="filterCategory" prefWidth="140" promptText="Category" />
            <ComboBox fx:id="filterStatus" prefWidth="120" promptText="Status" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#newPurchaseRequest" styleClass="quick-action-btn, qa-warning" text="Purchase Request" />
            <Button onAction="#newTransferRequest" styleClass="quick-action-btn" text="Transfer Request" />
        </HBox>

        <!-- Resources Table -->
        <VBox spacing="12" styleClass="panel-card" VBox.vgrow="ALWAYS">
            <Label styleClass="panel-title" text="Resource Inventory" />
            <TableView fx:id="resourcesTable" prefHeight="300" styleClass="incident-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="50" text="ID" />
                    <TableColumn fx:id="colName" prefWidth="140" text="Resource Name" />
                    <TableColumn fx:id="colCategory" prefWidth="100" text="Category" />
                    <TableColumn fx:id="colQuantity" prefWidth="80" text="Quantity" />
                    <TableColumn fx:id="colUnit" prefWidth="60" text="Unit" />
                    <TableColumn fx:id="colStatus" prefWidth="80" text="Status" />
                    <TableColumn fx:id="colLocation" prefWidth="120" text="Location" />
                    <TableColumn fx:id="colLastUpdated" prefWidth="100" text="Last Updated" />
                    <TableColumn fx:id="colActions" prefWidth="80" text="Actions" />
                </columns>
            </TableView>
        </VBox>

        <!-- Resource Status Bars -->
        <VBox spacing="12" styleClass="panel-card">
            <Label styleClass="panel-title" text="Resource Status Overview" />
            <VBox spacing="12">
                <VBox spacing="4">
                    <HBox alignment="CENTER_LEFT"><Label styleClass="resource-label" text="Relief Goods Allocation" /><Region HBox.hgrow="ALWAYS" /><Label fx:id="lblReliefPct" styleClass="resource-pct" text="68%" /></HBox>
                    <ProgressBar fx:id="pbRelief" maxWidth="Infinity" progress="0.68" styleClass="progress-green" />
                </VBox>
                <VBox spacing="4">
                    <HBox alignment="CENTER_LEFT"><Label styleClass="resource-label" text="Medical Supplies" /><Region HBox.hgrow="ALWAYS" /><Label fx:id="lblMedPct" styleClass="resource-pct" text="45%" /></HBox>
                    <ProgressBar fx:id="pbMed" maxWidth="Infinity" progress="0.45" styleClass="progress-amber" />
                </VBox>
                <VBox spacing="4">
                    <HBox alignment="CENTER_LEFT"><Label styleClass="resource-label" text="Emergency Fund Utilization" /><Region HBox.hgrow="ALWAYS" /><Label fx:id="lblFundPct" styleClass="resource-pct" text="22%" /></HBox>
                    <ProgressBar fx:id="pbFund" maxWidth="Infinity" progress="0.22" styleClass="progress-red" />
                </VBox>
            </VBox>
        </VBox>
    </VBox>
</ScrollPane>
